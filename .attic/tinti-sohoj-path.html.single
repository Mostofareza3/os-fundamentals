<!doctype html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>তিনটি সহজ পাঠ</title>
<style>
/* ============================================================
   DESIGN SYSTEM — every color, space and size is a token here.
   Nothing below :root hardcodes a value.
   Palette continues the companion book (user=blue, kernel=amber)
   and adds one accent per part: virtualization / concurrency /
   persistence.
   ============================================================ */
:root{
  /* ---- dark (default) ---- */
  --bg:#0E1319; --bg-soft:#121820; --panel:#18212B; --panel-2:#1E2833;
  --text:#CBD5E0; --muted:#8494A5; --heading:#F2F6FA;

  --user:#7FB4E6;   --user-dim:rgba(127,180,230,.11);
  --kernel:#E8AC64; --kernel-dim:rgba(232,172,100,.11);

  /* part accents */
  --p1:#7FB4E6; --p1-dim:rgba(127,180,230,.12);   /* virtualization */
  --p2:#C9A0E9; --p2-dim:rgba(201,160,233,.12);   /* concurrency    */
  --p3:#7FCBB0; --p3-dim:rgba(127,203,176,.12);   /* persistence    */

  --ok:#8FCB92;     --ok-dim:rgba(143,203,146,.10);
  --danger:#E58F8F; --danger-dim:rgba(229,143,143,.10);
  --warn:#E8C964;   --warn-dim:rgba(232,201,100,.10);

  --border:#28323E; --border-soft:#1F2833;
  --code-bg:#0A0F14; --code-text:#D7E0EA;
  --shadow:rgba(0,0,0,.45);
  --mark:rgba(232,172,100,.30);
  --scrim:rgba(0,0,0,.50); --scrim-strong:rgba(0,0,0,.55);

  /* ---- type scale ---- */
  --fs-xs:11.5px; --fs-sm:13px; --fs-base:15.5px; --fs-md:17px;
  --fs-lg:20px; --fs-xl:25px; --fs-2xl:31px; --fs-3xl:39px;
  --lh-tight:1.3; --lh-body:1.85; --lh-code:1.6;

  --fw-normal:400; --fw-med:500; --fw-semi:600; --fw-bold:700;

  /* ---- spacing (4px base) ---- */
  --s-1:4px; --s-2:8px; --s-3:12px; --s-4:16px; --s-5:20px;
  --s-6:24px; --s-8:32px; --s-10:40px; --s-12:48px; --s-16:64px;

  /* ---- geometry ---- */
  --sidebar-w:310px; --topbar-h:56px;
  /* Bangla glyphs are narrower per `ch` than Latin, so a 68ch measure
     reads far too cramped. Set the text column in px and let code and
     diagrams break out wider on large screens. */
  --measure:920px; --measure-wide:1180px;
  --radius:12px; --radius-sm:8px; --radius-xs:5px;

  /* ---- fonts: real Bangla fallbacks, no webfont ---- */
  --font-bn:"Kohinoor Bangla","Noto Sans Bengali","Noto Serif Bengali",
            "Nirmala UI","Bangla MN","Shonar Bangla","Vrinda",
            -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  --font-mono:"JetBrains Mono","SF Mono",ui-monospace,SFMono-Regular,
              Menlo,Consolas,"Liberation Mono","Courier New",monospace;

  --ease:cubic-bezier(.4,0,.2,1);
}
:root[data-theme="light"]{
  --bg:#FBFCFD; --bg-soft:#F3F6F9; --panel:#FFFFFF; --panel-2:#F5F8FA;
  --text:#33414E; --muted:#66788A; --heading:#111A23;
  --user:#2A6CA8; --user-dim:rgba(42,108,168,.08);
  --kernel:#9C5D14; --kernel-dim:rgba(156,93,20,.09);
  --p1:#2A6CA8; --p1-dim:rgba(42,108,168,.09);
  --p2:#7A4BA8; --p2-dim:rgba(122,75,168,.09);
  --p3:#1F7A5C; --p3-dim:rgba(31,122,92,.09);
  --ok:#37743F; --ok-dim:rgba(55,116,63,.08);
  --danger:#A94545; --danger-dim:rgba(169,69,69,.07);
  --warn:#8A6A12; --warn-dim:rgba(138,106,18,.09);
  --border:#DCE3EA; --border-soft:#E8EDF2;
  --code-bg:#141C25; --code-text:#D7E0EA;
  --shadow:rgba(30,45,60,.10);
  --mark:rgba(156,93,20,.22);
  --scrim:rgba(18,28,38,.38); --scrim-strong:rgba(18,28,38,.46);
}

/* ============================================================ RESET */
*{box-sizing:border-box;}
html,body{margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg); color:var(--text);
  font-family:var(--font-bn); font-size:var(--fs-base); line-height:var(--lh-body);
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto;}
  *{animation-duration:.01ms !important; transition-duration:.01ms !important;}
}
::selection{background:var(--user-dim); color:var(--heading);}
:focus-visible{outline:2px solid var(--user); outline-offset:2px; border-radius:var(--radius-xs);}

/* ============================================================ TOPBAR */
header.topbar{
  position:fixed; top:0; left:0; right:0; z-index:50;
  height:calc(var(--topbar-h) + env(safe-area-inset-top,0px));
  padding:0 var(--s-4); padding-top:env(safe-area-inset-top,0px);
  display:flex; align-items:center; gap:var(--s-3);
  background:color-mix(in srgb, var(--bg) 84%, transparent);
  backdrop-filter:saturate(180%) blur(14px);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--border-soft);
}
.brand{
  display:flex; align-items:baseline; gap:var(--s-2); min-width:0;
  font-weight:var(--fw-bold); font-size:var(--fs-sm); color:var(--heading);
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.brand .n{color:var(--kernel);}
.brand .sub{color:var(--muted); font-weight:var(--fw-semi);}
@media(max-width:860px){ .brand .sub{display:none;} }
.topbar .spacer{flex:1;}
.iconbtn{
  background:var(--panel); border:1px solid var(--border); color:var(--text);
  border-radius:var(--radius-sm); height:34px; min-width:34px; padding:0 var(--s-3);
  display:inline-flex; align-items:center; justify-content:center; gap:var(--s-2);
  cursor:pointer; font-size:var(--fs-sm); font-family:inherit; text-decoration:none;
  transition:border-color .15s var(--ease), background .15s var(--ease), color .15s var(--ease);
}
.iconbtn:hover{border-color:var(--user); color:var(--heading); background:var(--panel-2);}
.iconbtn kbd{
  font-family:var(--font-mono); font-size:var(--fs-xs); color:var(--muted);
  border:1px solid var(--border); border-radius:var(--radius-xs); padding:1px var(--s-1);
}
#oldBookBtn{border-color:var(--user); color:var(--user);}
#oldBookBtn:hover{background:var(--user-dim);}
#menuBtn{display:none;}
@media(max-width:1040px){ #menuBtn{display:inline-flex;} }
@media(max-width:720px){ .iconbtn .lbl{display:none;} }
#progress{
  position:fixed; top:0; left:0; height:2px; width:0; z-index:60;
  background:linear-gradient(90deg,var(--p1),var(--p2),var(--p3));
  transition:width .12s linear;
}

/* ============================================================ LAYOUT */
.layout{display:flex; padding-top:calc(var(--topbar-h) + env(safe-area-inset-top,0px)); min-height:100vh;}
nav.sidebar{
  width:var(--sidebar-w); flex-shrink:0;
  position:sticky; top:calc(var(--topbar-h) + env(safe-area-inset-top,0px));
  align-self:flex-start;
  height:calc(100vh - var(--topbar-h) - env(safe-area-inset-top,0px));
  overflow-y:auto; padding:var(--s-5) var(--s-3) var(--s-16);
  border-right:1px solid var(--border-soft); background:var(--bg-soft);
}
main{flex:1; min-width:0; display:flex; justify-content:center;}
.page{
  width:100%; max-width:var(--measure);
  padding:var(--s-10) var(--s-6) var(--s-16);
}
/* On wide screens let code blocks, diagrams and tables use more width
   than the prose column, since they are read as units, not line by line. */
@media(min-width:1500px){
  .page{max-width:var(--measure-wide);}
  .page > section.chapter > p,
  .page > section.chapter > ul,
  .page > section.chapter > ol,
  .page > section.chapter > .box,
  .page > section.chapter > .ch-head,
  .page > section.chapter > .qs,
  .page > section.chapter > h2,
  .page > section.chapter > h3,
  .page > section.chapter > h4,
  .page > section.chapter > .figcap{max-width:var(--measure);}
}
@media(max-width:1040px){
  nav.sidebar{
    position:fixed; left:0; top:calc(var(--topbar-h) + env(safe-area-inset-top,0px));
    z-index:45; transform:translateX(-100%); transition:transform .22s var(--ease);
    box-shadow:0 8px 40px var(--shadow);
  }
  nav.sidebar.open{transform:translateX(0);}
  #scrim{
    position:fixed; inset:0; z-index:40; background:var(--scrim);
    opacity:0; pointer-events:none; transition:opacity .2s var(--ease);
  }
  #scrim.on{opacity:1; pointer-events:auto;}
}
@media(min-width:1041px){ #scrim{display:none;} }

/* ============================================================ SIDEBAR TOC */
.toc-part{
  font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:.09em;
  color:var(--muted); font-weight:var(--fw-bold);
  padding:var(--s-5) var(--s-3) var(--s-2); display:flex; align-items:center; gap:var(--s-2);
}
.toc-part::before{content:""; width:var(--s-2); height:var(--s-2); border-radius:50%; background:currentColor;}
.toc-part.p1{color:var(--p1);} .toc-part.p2{color:var(--p2);} .toc-part.p3{color:var(--p3);}
a.toc-item{
  display:flex; gap:var(--s-3); align-items:baseline;
  padding:var(--s-2) var(--s-3); margin-bottom:1px;
  border-radius:var(--radius-sm); text-decoration:none;
  color:var(--text); font-size:var(--fs-sm); line-height:1.45;
  border-left:2px solid transparent;
  transition:background .14s var(--ease), color .14s var(--ease);
}
a.toc-item:hover{background:var(--panel); color:var(--heading);}
a.toc-item .num{
  font-family:var(--font-mono); font-size:var(--fs-xs);
  color:var(--muted); flex-shrink:0; min-width:2.2ch; text-align:right;
}
a.toc-item.active{background:var(--panel-2); color:var(--heading); font-weight:var(--fw-semi);}
a.toc-item.active.p1{border-left-color:var(--p1);} a.toc-item.active.p1 .num{color:var(--p1);}
a.toc-item.active.p2{border-left-color:var(--p2);} a.toc-item.active.p2 .num{color:var(--p2);}
a.toc-item.active.p3{border-left-color:var(--p3);} a.toc-item.active.p3 .num{color:var(--p3);}

/* ============================================================ TYPOGRAPHY */
.page h1,.page h2,.page h3,.page h4{
  color:var(--heading); line-height:var(--lh-tight); text-wrap:balance;
  font-weight:var(--fw-bold); margin:0;
}
.page h1{font-size:var(--fs-2xl); margin-bottom:var(--s-3);}
.page h2{
  font-size:var(--fs-xl); margin-top:var(--s-12); margin-bottom:var(--s-4);
  padding-bottom:var(--s-2); border-bottom:1px solid var(--border-soft);
}
.page h3{font-size:var(--fs-lg); margin-top:var(--s-10); margin-bottom:var(--s-3);}
.page h4{font-size:var(--fs-md); margin-top:var(--s-6); margin-bottom:var(--s-2); color:var(--text);}
.page p{margin:0 0 var(--s-4);}
.page ul,.page ol{margin:0 0 var(--s-4); padding-left:var(--s-6);}
.page li{margin-bottom:var(--s-2);}
.page li::marker{color:var(--muted);}
.page a{color:var(--user); text-decoration:none; border-bottom:1px solid var(--user-dim);}
.page a:hover{border-bottom-color:var(--user);}
.page strong{color:var(--heading); font-weight:var(--fw-semi);}
.page em{font-style:normal; color:var(--kernel);}
.page hr{border:0; border-top:1px solid var(--border-soft); margin:var(--s-10) 0;}

/* chapter header block */
.ch-head{margin-bottom:var(--s-8); padding-bottom:var(--s-5); border-bottom:1px solid var(--border);}
.ch-eyebrow{
  display:inline-flex; align-items:center; gap:var(--s-2);
  font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:.09em;
  font-weight:var(--fw-bold); margin-bottom:var(--s-3);
}
.ch-eyebrow.p1{color:var(--p1);} .ch-eyebrow.p2{color:var(--p2);} .ch-eyebrow.p3{color:var(--p3);}
.ch-eyebrow .src{color:var(--muted); font-weight:var(--fw-normal); text-transform:none; letter-spacing:0;}
.ch-lede{font-size:var(--fs-md); color:var(--muted); margin:0;}

/* inline code */
.page :not(pre) > code{
  font-family:var(--font-mono); font-size:.88em;
  background:var(--panel-2); color:var(--heading);
  border:1px solid var(--border-soft); border-radius:var(--radius-xs);
  padding:.1em .38em; white-space:nowrap;
}

/* ============================================================ CODE / ASCII */
pre{
  margin:0 0 var(--s-5); padding:var(--s-4);
  background:var(--code-bg); color:var(--code-text);
  border:1px solid var(--border); border-radius:var(--radius);
  overflow-x:auto; max-width:100%;
  font-family:var(--font-mono); font-size:var(--fs-sm); line-height:var(--lh-code);
  -webkit-overflow-scrolling:touch;
}
pre code{font-family:inherit; font-size:inherit; background:none; border:0; padding:0; white-space:pre;}
pre.ascii{line-height:1.45; color:var(--muted);}
.codewrap{position:relative;}
.codewrap .lang{
  position:absolute; top:var(--s-2); right:var(--s-3);
  font-family:var(--font-mono); font-size:var(--fs-xs);
  color:var(--muted); text-transform:uppercase; letter-spacing:.06em;
  pointer-events:none;
}
.figcap{
  font-size:var(--fs-xs); color:var(--muted);
  margin:calc(var(--s-5) * -1 + var(--s-1)) 0 var(--s-5); text-align:center;
}

/* ============================================================ TABLES */
.tablewrap{overflow-x:auto; margin:0 0 var(--s-5); border:1px solid var(--border); border-radius:var(--radius);}
table{border-collapse:collapse; width:100%; font-size:var(--fs-sm);}
th,td{padding:var(--s-3) var(--s-4); text-align:left; border-bottom:1px solid var(--border-soft);}
th{background:var(--panel-2); color:var(--heading); font-weight:var(--fw-semi); white-space:nowrap;}
tr:last-child td{border-bottom:0;}
td.num,th.num{font-family:var(--font-mono); font-variant-numeric:tabular-nums; text-align:right;}

/* ============================================================ CALLOUTS */
.box{
  margin:0 0 var(--s-5); padding:var(--s-4) var(--s-5);
  border-radius:var(--radius); border:1px solid var(--border);
  border-left-width:3px; background:var(--panel);
}
.box > .box-t{
  display:flex; align-items:center; gap:var(--s-2);
  font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:.08em;
  font-weight:var(--fw-bold); margin-bottom:var(--s-3);
}
.box > :last-child{margin-bottom:0;}
.box.wrong{border-left-color:var(--danger); background:var(--danger-dim);}
.box.wrong > .box-t{color:var(--danger);}
.box.note{border-left-color:var(--user); background:var(--user-dim);}
.box.note > .box-t{color:var(--user);}
.box.dev{border-left-color:var(--ok); background:var(--ok-dim);}
.box.dev > .box-t{color:var(--ok);}
.box.warn{border-left-color:var(--warn); background:var(--warn-dim);}
.box.warn > .box-t{color:var(--warn);}
.box.old{border-left-color:var(--kernel); background:var(--kernel-dim);}
.box.old > .box-t{color:var(--kernel);}

/* questions block */
.qs{margin-top:var(--s-12); padding-top:var(--s-6); border-top:1px solid var(--border);}
.qs h2{margin-top:0; border-bottom:0; padding-bottom:0;}
.qs ol{counter-reset:q; list-style:none; padding-left:0;}
.qs ol li{
  counter-increment:q; position:relative;
  padding-left:var(--s-10); margin-bottom:var(--s-4);
}
.qs ol li::before{
  content:counter(q); position:absolute; left:0; top:0;
  font-family:var(--font-mono); font-size:var(--fs-xs); font-weight:var(--fw-bold);
  color:var(--muted); background:var(--panel-2);
  border:1px solid var(--border); border-radius:var(--radius-xs);
  width:var(--s-6); height:var(--s-6); display:flex; align-items:center; justify-content:center;
}

/* ============================================================ CHAPTER NAV */
.chnav{display:flex; gap:var(--s-3); margin-top:var(--s-12); flex-wrap:wrap;}
.chnav a{
  flex:1 1 220px; min-width:0; text-decoration:none; border:0;
  padding:var(--s-4); border-radius:var(--radius);
  background:var(--panel); border:1px solid var(--border);
  transition:border-color .15s var(--ease);
}
.chnav a:hover{border-color:var(--user);}
.chnav .dir{font-size:var(--fs-xs); color:var(--muted); text-transform:uppercase; letter-spacing:.08em;}
.chnav .t{color:var(--heading); font-weight:var(--fw-semi); font-size:var(--fs-sm); display:block; margin-top:var(--s-1);}
.chnav a.next{text-align:right;}

/* ============================================================ SEARCH */
#searchOverlay{
  position:fixed; inset:0; z-index:70; display:none;
  background:var(--scrim-strong); padding:var(--s-10) var(--s-4);
  backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px);
}
#searchOverlay.on{display:block;}
.search-panel{
  max-width:680px; margin:0 auto; background:var(--panel);
  border:1px solid var(--border); border-radius:var(--radius);
  box-shadow:0 20px 70px var(--shadow); overflow:hidden;
  display:flex; flex-direction:column; max-height:75vh;
}
.search-head{display:flex; align-items:center; gap:var(--s-3); padding:var(--s-4); border-bottom:1px solid var(--border-soft);}
.search-head input{
  flex:1; background:none; border:0; outline:0; color:var(--heading);
  font-family:inherit; font-size:var(--fs-md);
}
.search-head input::placeholder{color:var(--muted);}
#searchResults{overflow-y:auto; padding:var(--s-2);}
a.sr{
  display:block; padding:var(--s-3) var(--s-4); border-radius:var(--radius-sm);
  text-decoration:none; border:0; color:var(--text);
}
a.sr:hover,a.sr.sel{background:var(--panel-2);}
a.sr .sr-t{color:var(--heading); font-weight:var(--fw-semi); font-size:var(--fs-sm);}
a.sr .sr-c{font-size:var(--fs-xs); color:var(--muted); display:block; margin-top:var(--s-1); line-height:1.5;}
a.sr mark{background:var(--mark); color:var(--heading); border-radius:2px; padding:0 2px;}
.search-empty{padding:var(--s-6); text-align:center; color:var(--muted); font-size:var(--fs-sm);}
.search-foot{
  display:flex; gap:var(--s-4); padding:var(--s-3) var(--s-4);
  border-top:1px solid var(--border-soft); font-size:var(--fs-xs); color:var(--muted);
}
.search-foot kbd{
  font-family:var(--font-mono); border:1px solid var(--border);
  border-radius:var(--radius-xs); padding:1px var(--s-1); margin-right:2px;
}

/* ============================================================ COVER */
.cover-hero{padding:var(--s-8) 0 var(--s-10); border-bottom:1px solid var(--border); margin-bottom:var(--s-8);}
.cover-hero .kicker{
  font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:.14em;
  color:var(--muted); font-weight:var(--fw-bold); margin-bottom:var(--s-4);
}
.cover-hero h1{font-size:var(--fs-3xl); margin-bottom:var(--s-4);}
.cover-hero .three{
  display:flex; gap:var(--s-2); flex-wrap:wrap; margin-bottom:var(--s-5);
  font-family:var(--font-mono); font-size:var(--fs-sm);
}
.cover-hero .three span{
  padding:var(--s-1) var(--s-3); border-radius:100px; border:1px solid var(--border);
}
.cover-hero .three .a1{color:var(--p1); border-color:var(--p1); background:var(--p1-dim);}
.cover-hero .three .a2{color:var(--p2); border-color:var(--p2); background:var(--p2-dim);}
.cover-hero .three .a3{color:var(--p3); border-color:var(--p3); background:var(--p3-dim);}
.cover-hero .lede{font-size:var(--fs-md); color:var(--muted); max-width:56ch; margin:0;}

/* ============================================================ UTIL */
[hidden]{display:none !important;}
.chapter{display:none;}
.chapter.on{display:block;}
.skip{position:absolute; left:-9999px;}
.skip:focus{left:var(--s-4); top:var(--s-4); z-index:100; background:var(--panel); padding:var(--s-3); border-radius:var(--radius-sm);}
</style>
</head>
<body>
<a class="skip" href="#main">সরাসরি লেখায় যাও</a>
<div id="progress"></div>

<header class="topbar">
  <button class="iconbtn" id="menuBtn" aria-label="সূচিপত্র" aria-expanded="false">☰</button>
  <div class="brand">
    <span class="n">তিনটি সহজ পাঠ</span>
    <span class="sub">— Operating Systems</span>
  </div>
  <div class="spacer"></div>
  <a class="iconbtn" id="oldBookBtn" href="index.html" title="আগের বই — ভিতর থেকে">
    📗 <span class="lbl">ভিতর থেকে</span>
  </a>
  <button class="iconbtn" id="searchBtn" aria-label="খুঁজো">
    🔍 <kbd>/</kbd>
  </button>
  <button class="iconbtn" id="themeBtn" aria-label="Theme পাল্টাও" title="Theme">◐</button>
</header>

<div id="scrim"></div>

<div class="layout">
  <nav class="sidebar" id="sidebar" aria-label="সূচিপত্র"></nav>
  <main id="main">
    <div class="page" id="page">
      <!-- CHAPTERS APPENDED BELOW THIS LINE -->
    <section class="chapter" id="chapter-1" data-part="1" data-num="1"
         data-title="OS কেন আছে — তিনটি সমস্যা">

  <div class="ch-head">
    <div class="ch-eyebrow p1">
      Part 1 · Virtualization
      <span class="src">· OSTEP ch 2, pdf p24–41</span>
    </div>
    <h1>OS কেন আছে — তিনটি সমস্যা</h1>
    <p class="ch-lede">
      একটা CPU, কিন্তু চল্লিশটা process চলছে। ১৬GB RAM, কিন্তু প্রতিটা process
      ভাবছে পুরো address space তার একলার। Power চলে গেল, তবু data রয়ে গেল।
      এই তিনটা illusion কীভাবে টিকে আছে — আর কোথায় ফাটল ধরে।
    </p>
  </div>

  <p>
    আপনি যখন <code>node server.js</code> চালান, আপনার ধারণা হয় program টা
    সরাসরি hardware এর উপর চলছে। চলছে না। মাঝখানে একটা layer আছে যেটা
    আপনার program কে <em>মিথ্যা বলে</em> — সুপরিকল্পিত, দরকারি মিথ্যা।
    সেই layer টার নাম operating system, আর এই বইটা মূলত সেই মিথ্যাগুলোর
    গঠন নিয়ে: কোনটা কীভাবে বানানো, কত খরচে, আর কোন পরিস্থিতিতে মিথ্যাটা
    ভেঙে গিয়ে আসল hardware বেরিয়ে পড়ে।
  </p>

  <p>
    OSTEP বইটা পুরো বিষয়টাকে তিন ভাগে সাজিয়েছে, আর সেই ভাগটা এত ভালো যে
    আমরাও সেটাই রাখছি — <strong>virtualization</strong>,
    <strong>concurrency</strong>, <strong>persistence</strong>। এই chapter এ
    তিনটাকেই একবার দেখে নেব, কারণ বাকি ২৯টা chapter এই তিনটা সমস্যার
    বিস্তারিত উত্তর।
  </p>

  <h2 id="c1-von-neumann">শুরুর জায়গা — একটা বোকা যন্ত্র</h2>

  <p>
    Processor যা করে তা হতাশাজনকভাবে সরল। একটা loop:
    memory থেকে instruction আনা (fetch), সেটা কী বলছে বোঝা (decode),
    সেটা করা (execute), তারপর পরেরটা। এটাই von Neumann model।
    একটা আধুনিক core সেকেন্ডে কয়েক <em>বিলিয়ন</em> বার এই চক্র ঘোরায়।
  </p>

  <pre class="ascii"><code>   ┌──────────────── CPU core ────────────────┐
   │                                          │
   │   PC ──▶ fetch ──▶ decode ──▶ execute    │
   │   ▲                              │       │
   │   └──────────────────────────────┘       │
   │            (PC বাড়ে, আবার শুরু)          │
   └──────────────────────────────────────────┘
              │ load / store
              ▼
   ┌──────────────────────────────────────────┐
   │  Memory — byte এর একটা বিশাল array       │
   │  0                              2^48-1   │
   └──────────────────────────────────────────┘</code></pre>
  <p class="figcap">fetch–decode–execute: এর বাইরে CPU কিছু জানে না।</p>

  <p>
    আসল CPU এর চেয়ে এটা সরল করে বলা হলো। বাস্তবে একটা core একসাথে
    কয়েকটা instruction চালায় (superscalar), ক্রম ভেঙে চালায়
    (out-of-order), আর branch কোন দিকে যাবে তা আগেই অনুমান করে চালিয়ে ফেলে
    (speculative execution)। OSTEP এই জটিলতাগুলো সচেতনভাবে সরিয়ে রেখেছে,
    আমরাও আপাতত রাখছি — কারণ আপনার program যে model ধরে লেখা হয়, সেটা এই
    sequential model টাই।
  </p>

  <p>
    তবে একটা কথা মনে রাখুন, কারণ chapter 13, 14 আর 30 এ এটা ফিরে আসবে:
    এই তিনটা optimization নিরীহ নয়। Out-of-order execution এর কারণেই
    memory model দরকার হয়। আর speculative execution এর কারণেই
    Meltdown আর Spectre সম্ভব হয়েছিল — যেখানে hardware এর একটা
    performance trick পুরো OS এর protection guarantee ভেঙে দিয়েছিল।
  </p>

  <div class="box note">
    <div class="box-t">সংজ্ঞা</div>
    <p>
      <strong>OS (Operating System — যে software টা hardware আর আপনার
      program এর মাঝখানে বসে resource ভাগ করে আর abstraction দেয়)।</strong>
      পুরনো নাম ছিল <em>supervisor</em>, আরও পুরনো নাম
      <em>master control program</em> — শেষেরটা একটু বেশি আত্মবিশ্বাসী
      শোনায় বলেই সম্ভবত টেকেনি।
    </p>
  </div>

  <h2 id="c1-three-roles">OS কে তিনভাবে দেখা যায়</h2>

  <p>
    একটা OS কী, তার একটা উত্তর নেই — কোন দিক থেকে দেখছেন তার উপর নির্ভর করে।
    তিনটা দৃষ্টিভঙ্গি, তিনটাই সঠিক:
  </p>

  <ol>
    <li>
      <strong>Virtualizer</strong> — একটা physical resource নিয়ে তাকে
      আরও সাধারণ, শক্তিশালী, ব্যবহারযোগ্য একটা virtual রূপে বদলে দেয়।
      একটা CPU হয়ে যায় অসংখ্য virtual CPU। এই কারণেই OS কে মাঝে মাঝে
      <em>virtual machine</em> বলা হয়।
    </li>
    <li>
      <strong>Standard library</strong> — program চালানো, memory নেওয়া,
      file পড়া, packet পাঠানো — এসব করার জন্য OS কয়েকশো
      <strong>system call</strong> export করে। আপনার কাছে এগুলো function
      call এর মতোই দেখায়।
    </li>
    <li>
      <strong>Resource manager</strong> — যেহেতু অনেক program একসাথে
      CPU, memory আর disk ভাগ করছে, কাকে কখন কতটুকু দেওয়া হবে সেই
      সিদ্ধান্ত OS নেয় — কখনো efficiency এর কথা ভেবে, কখনো fairness এর।
    </li>
  </ol>

  <p>
    এই তিনটার মধ্যে দ্বিতীয়টা নিয়ে সবচেয়ে বেশি ভুল হয়, তাই সেটা এখনই
    পরিষ্কার করে নেওয়া ভালো।
  </p>

  <div class="box wrong">
    <div class="box-t">ভুল ধারণা</div>
    <p>
      <strong>"<code>malloc()</code>, <code>printf()</code>,
      <code>fopen()</code> — এগুলো system call।"</strong>
      অথবা উল্টোটা: <strong>"library এর প্রতিটা function call kernel এ
      ঢোকে, তাই library call খরচি।"</strong>
    </p>
    <p>
      দুটোই ভুল। এগুলো <strong>library function</strong>, আর তাদের বেশিরভাগ
      call কখনো kernel এ ঢোকেই না:
    </p>
    <ul>
      <li>
        <code>malloc()</code> একটা userspace allocator। তার কাছে আগে থেকে
        নেওয়া memory থাকলে সে কোনো syscall ছাড়াই, ~১৫-২৫ nanosecond এ
        pointer ফেরত দেয়। শুধু pool শেষ হলে <code>mmap()</code> বা
        <code>brk()</code> দিয়ে kernel এ যায়।
      </li>
      <li>
        <code>printf()</code> আপনার লেখা buffer এ জমায়। Buffer ভরলে বা
        newline পেলে (terminal এ) তখন একটা <code>write()</code> syscall হয়।
        দশটা <code>printf()</code> মানে দশটা syscall নয়।
      </li>
      <li>
        <code>clock_gettime()</code> সাধারণত syscall ছাড়াই ফেরে — kernel
        একটা page (vDSO — virtual Dynamic Shared Object) প্রতিটা process এর
        address space এ map করে রাখে, যেখান থেকে সময় সরাসরি পড়া যায়।
      </li>
    </ul>
    <p>
      পার্থক্যটা মাপা যায়: একটা syscall ~৫০-৪০০ns (Spectre mitigation
      চালু থাকলে আরও বেশি), আর একটা সাধারণ function call ~১-২ns।
      <strong>দুইশো গুণ ব্যবধান।</strong> কোনটা কোথায় যাচ্ছে তা
      <code>strace</code> দিয়ে দেখা যায় — chapter 4 এ করব।
    </p>
  </div>

  <h2 id="c1-cpu">সমস্যা ১ — একটা CPU, অনেক program</h2>

  <p>
    OSTEP একটা ছোট program দিয়ে শুরু করে। এটা কিছুই করে না — এক সেকেন্ড
    ঘোরে, একটা string ছাপে, আবার ঘোরে:
  </p>

  <div class="codewrap"><span class="lang">c</span>
  <pre><code>/* cpu.c — spin for one second, print, repeat forever */
#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;

/* Spin() busy-waits by repeatedly checking the clock
   until one second of wall time has passed. */
void Spin(int seconds);

int main(int argc, char *argv[]) {
    if (argc != 2) {
        fprintf(stderr, "usage: cpu &lt;string&gt;\n");
        exit(1);
    }
    char *str = argv[1];
    while (1) {
        Spin(1);
        printf("%s\n", str);
    }
    return 0;
}</code></pre></div>

  <p>একটা চালালে যা আশা করেন তাই হয়:</p>

  <pre><code>$ gcc -o cpu cpu.c -Wall
$ ./cpu A
A
A
A
^C</code></pre>

  <p>এখন চারটা একসাথে চালান — একটাই CPU ধরে নিন:</p>

  <pre><code>$ ./cpu A &amp; ./cpu B &amp; ./cpu C &amp; ./cpu D &amp;
[1] 7353
[2] 7354
[3] 7355
[4] 7356
A
B
D
C
A
B
D
C
A
C
B
D
...</code></pre>

  <p>
    চারটা program একসাথে চলছে বলে মনে হচ্ছে, যদিও CPU একটা।
    এটাই <strong>CPU virtualization</strong> — একটা physical CPU কে
    আপাত-অসীম সংখ্যক virtual CPU তে রূপান্তর। Hardware সাহায্য করে
    (timer interrupt), OS সিদ্ধান্ত নেয় (scheduler), আর আপনি illusion টা পান।
  </p>

  <p>
    লক্ষ করুন output এর ক্রম <code>A B D C</code>, তারপর
    <code>A B D C</code>, তারপর <code>A C B D</code> — <em>বদলে যাচ্ছে</em>।
    কেউ ঠিক করে দেয়নি কে আগে ছাপবে। এই non-determinism টা bug নয়,
    এটাই scheduler এর স্বভাব, আর chapter 12 এ দেখব এটাই race condition এর
    উৎস।
  </p>

  <div class="box wrong">
    <div class="box-t">ভুল ধারণা</div>
    <p>
      <strong>"Output interleaved মানে চারটা program একইসাথে চলছে।"</strong>
    </p>
    <p>
      একটা CPU তে না। যেকোনো মুহূর্তে ঠিক <em>একটা</em> process ই চলছে।
      OS দ্রুত একটা থেকে আরেকটায় লাফাচ্ছে (context switch, chapter 4) —
      এত দ্রুত যে মানুষের চোখে একসাথে মনে হয়। এটা
      <strong>concurrency</strong> (কাজগুলো overlap করে এগোচ্ছে), কিন্তু
      <strong>parallelism</strong> নয় (একই মুহূর্তে একাধিক কাজ)।
    </p>
    <p>
      ২০২৬ এ উল্টো ভুলটাও সমান প্রচলিত: আপনার laptop এ ১০টা core আছে, তাই
      আপনি ধরে নেন সব সত্যিই parallel চলছে। কিন্তু container এ
      <code>cpu.max</code> দিয়ে আপনাকে ২ core এর সমান quota দেওয়া হলে,
      ১০টা thread চালালেও আপনি ২ core এর কাজই পাবেন — বাকি সময় thread গুলো
      throttled হয়ে বসে থাকবে। এটা production এ সবচেয়ে সাধারণ
      performance bug, chapter 7 এ পুরোটা আছে।
    </p>
  </div>

  <h2 id="c1-mem">সমস্যা ২ — একই address, আলাদা memory</h2>

  <p>
    Physical memory একটা byte array, এর চেয়ে বেশি কিছু নয়। একটা program
    চলার সময় সারাক্ষণ এই array পড়ছে (load) আর লিখছে (store) — শুধু data
    নয়, প্রতিটা instruction fetch ও একটা memory access।
  </p>

  <p>পরের program টা একটা int allocate করে, তার address ছাপে, তারপর সেটা বাড়াতে থাকে:</p>

  <div class="codewrap"><span class="lang">c</span>
  <pre><code>/* mem.c — allocate one int, print its address, increment forever */
#include &lt;unistd.h&gt;
#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;assert.h&gt;

void Spin(int seconds);

int main(int argc, char *argv[]) {
    int *p = malloc(sizeof(int));       /* allocate 4 bytes */
    assert(p != NULL);
    printf("(pid:%d) addr of p: %p\n", (int) getpid(), p);
    *p = 0;
    while (1) {
        Spin(1);
        *p = *p + 1;
        printf("(pid:%d) value of p: %d\n", getpid(), *p);
    }
    return 0;
}</code></pre></div>

  <p>দুটো instance একসাথে চালালে অদ্ভুত কিছু দেখা যায়:</p>

  <pre><code>$ ./mem &amp; ./mem &amp;
[1] 24113
[2] 24114
(pid:24113) addr of p: 0x200000
(pid:24114) addr of p: 0x200000     ←  একই address!
(pid:24113) value of p: 1
(pid:24114) value of p: 1
(pid:24113) value of p: 2
(pid:24114) value of p: 2
(pid:24113) value of p: 3
(pid:24114) value of p: 3</code></pre>

  <p>
    দুটো process একই address <code>0x200000</code> পেয়েছে, অথচ একজন
    অন্যজনের counter নষ্ট করছে না। প্রত্যেকে নিজের মতো ১, ২, ৩ গুনছে।
  </p>

  <p>
    কারণ ওই address টা <strong>physical</strong> নয়,
    <strong>virtual</strong>। প্রতিটা process একটা নিজস্ব
    <strong>address space</strong> পায় — byte এর একটা কাল্পনিক array, যার
    সূচনা শূন্য থেকে। OS (আর hardware এর MMU) এই virtual address গুলোকে
    আসল physical address এ অনুবাদ করে, প্রতিটা process এর জন্য আলাদা
    mapping দিয়ে।
  </p>

  <pre class="ascii"><code>  Process 24113                      Process 24114
  virtual address space              virtual address space
  ┌────────────────┐                 ┌────────────────┐
  │                │                 │                │
  │  0x200000 ●────┼──┐         ┌────┼──● 0x200000    │
  │                │  │         │    │                │
  └────────────────┘  │         │    └────────────────┘
                      │         │
              page table         page table
                      │         │
                      ▼         ▼
       ┌──────────────────────────────────────────┐
       │  Physical RAM                            │
       │        ┌────┐            ┌────┐          │
       │        │0x7a│            │0x3c│          │
       │        └────┘            └────┘          │
       └──────────────────────────────────────────┘
          একই virtual address → আলাদা physical frame</code></pre>
  <p class="figcap">
    Address space virtualization: একই সংখ্যা, ভিন্ন গন্তব্য।
  </p>

  <p>
    এই উদাহরণটা কাজ করানোর জন্য আজকাল একটা জিনিস বন্ধ করতে হয় —
    <strong>ASLR (Address Space Layout Randomization — প্রতিবার চালালে
    stack, heap আর library গুলোকে এলোমেলো address এ বসানো, যাতে attacker
    আগে থেকে address অনুমান করতে না পারে)</strong>। ASLR চালু থাকলে
    দুটো process আলাদা address দেখাবে। বন্ধ করতে:
  </p>

  <pre><code># Linux: disable ASLR for one command
$ setarch $(uname -m) -R ./mem

# or globally (needs root, and don't leave it off)
$ sudo sysctl -w kernel.randomize_va_space=0</code></pre>

  <div class="box dev">
    <div class="box-t">আপনার কাজের সাথে যোগ</div>
    <p>
      এই isolation টাই কারণ যে <code>docker run</code> করলে দুটো container
      একই port এ bind করতে পারে (আলাদা network namespace), অথবা একই
      binary এর দুটো copy চললেও একজন আরেকজনের variable দেখে না।
      কিন্তু isolation টা <em>সম্পূর্ণ</em> নয় — chapter 29 এ দেখব
      container আসলে namespace + cgroup এর একটা সংকলন, আর কোন জায়গাগুলো
      ফাঁক থেকে যায়।
    </p>
    <p>
      আরেকটা যোগসূত্র: Node এ একটা <code>Buffer.alloc(1e9)</code> করলে
      <code>top</code> এ VIRT লাফিয়ে বাড়ে কিন্তু RSS বাড়ে না। কারণ
      virtual address space বুক করা আর physical page পাওয়া দুটো আলাদা
      ঘটনা — chapter 11 এ এটাই মূল বিষয়।
    </p>
  </div>

  <h2 id="c1-conc">সমস্যা ৩ — একসাথে চললে হিসাব মেলে না</h2>

  <p>
    এখন পর্যন্ত আলাদা process দেখেছি, যাদের memory আলাদা। কিন্তু একই
    memory ভাগ করে একাধিক execution চললে? সেটাই
    <strong>thread</strong> — একই address space এর ভিতরে চলা একাধিক
    execution path।
  </p>

  <div class="codewrap"><span class="lang">c</span>
  <pre><code>/* threads.c — two threads increment a shared counter */
#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;pthread.h&gt;

volatile int counter = 0;      /* NOTE: volatile is NOT the fix — see below */
int loops;

void *worker(void *arg) {
    for (int i = 0; i &lt; loops; i++) {
        counter++;
    }
    return NULL;
}

int main(int argc, char *argv[]) {
    if (argc != 2) { fprintf(stderr, "usage: threads &lt;loops&gt;\n"); exit(1); }
    loops = atoi(argv[1]);

    pthread_t p1, p2;
    printf("Initial value : %d\n", counter);
    pthread_create(&amp;p1, NULL, worker, NULL);
    pthread_create(&amp;p2, NULL, worker, NULL);
    pthread_join(p1, NULL);
    pthread_join(p2, NULL);
    printf("Final value   : %d\n", counter);
    return 0;
}</code></pre></div>

  <p>
    দুটো thread, প্রত্যেকে <code>loops</code> বার counter বাড়াচ্ছে।
    উত্তর হওয়া উচিত <code>2 × loops</code>। ছোট সংখ্যায় মিলেও যায়:
  </p>

  <pre><code>$ gcc -o threads threads.c -Wall -pthread
$ ./threads 1000
Initial value : 0
Final value   : 2000          ←  ঠিক আছে</code></pre>

  <p>সংখ্যা বাড়ান:</p>

  <pre><code>$ ./threads 100000
Initial value : 0
Final value   : 143012        ←  200000 হওয়া উচিত ছিল

$ ./threads 100000
Initial value : 0
Final value   : 137298        ←  আবার চালালে অন্য উত্তর!</code></pre>

  <p>
    প্রতিবার আলাদা উত্তর, আর কখনো কখনো ঠিক উত্তরও আসে — যেটা সবচেয়ে
    বিপজ্জনক, কারণ test এ ধরা পড়ে না।
  </p>

  <p>
    কারণটা <code>counter++</code> লাইনে। C তে এক লাইন, কিন্তু machine এ
    তিনটা ধাপ:
  </p>

  <pre class="ascii"><code>  counter++  →   mov  eax, [counter]    ; 1. memory থেকে register এ আনো
                 add  eax, 1            ; 2. register এ ১ যোগ করো
                 mov  [counter], eax    ; 3. memory তে ফেরত লেখো

  দুটো thread, counter = 50 থেকে শুরু:

  Thread 1                    Thread 2               counter
  ─────────────────────────────────────────────────── ───────
  mov eax,[counter]  (50)                               50
  add eax,1          (51)
        ─── context switch ───▶
                              mov eax,[counter] (50)    50   ← পুরনো মান!
                              add eax,1         (51)
                              mov [counter],eax         51
        ◀── context switch ───
  mov [counter],eax                                     51   ← হারিয়ে গেল
  ─────────────────────────────────────────────────── ───────
  দুটো increment হলো, counter বাড়ল মাত্র ১।</code></pre>
  <p class="figcap">Lost update: তিন ধাপের মাঝখানে switch হলেই হিসাব নষ্ট।</p>

  <p>
    এই সমস্যাটার নাম <strong>race condition</strong>, আর যে অংশটা
    একসাথে একজনের বেশি চালানো নিরাপদ নয় তার নাম
    <strong>critical section</strong>। সমাধান দরকার এমন কিছু, যা ওই তিন
    ধাপকে একটা অবিভাজ্য (atomic) একক বানায় — সেটাই lock, chapter 15।
  </p>

  <div class="box wrong">
    <div class="box-t">ভুল ধারণা</div>
    <p>
      <strong>"উপরের code এ <code>volatile</code> আছে, তাই ওটাই
      সমস্যা সমাধান করার কথা ছিল।"</strong>
    </p>
    <p>
      না। এটা এই বইয়ের source (OSTEP) থেকে পাওয়া সবচেয়ে ক্ষতিকর
      শিক্ষা, আর আমি ইচ্ছে করেই code টা হুবহু রেখেছি যাতে এখনই
      সংশোধন করা যায়।
    </p>
    <p>
      <code>volatile</code> compiler কে বলে "এই variable এর access
      optimize করে সরিয়ে দিও না, প্রতিবার সত্যিই memory থেকে পড়ো।"
      এটা <strong>synchronization primitive নয়</strong>। এটা—
    </p>
    <ul>
      <li><code>counter++</code> কে atomic বানায় না (তিন ধাপ তিন ধাপই থাকে);</li>
      <li>CPU এর instruction reordering আটকায় না;</li>
      <li>অন্য core এর cache এ আপনার লেখা কখন দেখা যাবে, তার কোনো নিশ্চয়তা দেয় না।</li>
    </ul>
    <p>
      আর C11/C++11 এর ভাষায় এই code টা শুধু "ভুল উত্তর দেয়" এমন নয় —
      এটা <strong>undefined behavior</strong>, কারণ synchronization ছাড়া
      দুটো thread একই non-atomic object এ লিখছে। মানে compiler আইনত
      যা খুশি করতে পারে। ঠিক সমাধান <code>_Atomic int</code> বা
      <code>atomic_fetch_add()</code> বা একটা mutex — chapter 14 পুরোটাই
      এই নিয়ে, আর ওখানে দেখব কেন Apple Silicon এ কাজ করা code
      Graviton এ ভেঙে যেতে পারে।
    </p>
  </div>

  <h2 id="c1-persist">সমস্যা ৩.৫ — power গেলে সব যায়</h2>

  <p>
    DRAM <strong>volatile</strong> — current বন্ধ হলে content শেষ।
    তাই যা রাখতে হবে, তা যেতে হবে এমন device এ যা power ছাড়াও মনে রাখে:
    HDD, বা আজকাল প্রায় সবসময় SSD। এই দায়িত্বটা OS এর যে অংশের,
    তার নাম <strong>file system</strong>।
  </p>

  <div class="codewrap"><span class="lang">c</span>
  <pre><code>/* io.c — write a string to a file */
#include &lt;stdio.h&gt;
#include &lt;unistd.h&gt;
#include &lt;assert.h&gt;
#include &lt;fcntl.h&gt;

int main(int argc, char *argv[]) {
    int fd = open("/tmp/file", O_WRONLY | O_CREAT | O_TRUNC, S_IRWXU);
    assert(fd &gt; -1);
    int rc = write(fd, "hello world\n", 13);
    assert(rc == 13);
    close(fd);
    return 0;
}</code></pre></div>

  <p>
    এখানে তিনটা system call: <code>open()</code>, <code>write()</code>,
    <code>close()</code>। লক্ষণীয় যে OS এখানে virtualization এর নীতি
    থেকে <em>সচেতনভাবে সরে এসেছে</em> — CPU আর memory প্রতিটা process এর
    জন্য আলাদা করে virtualize করা হয়, কিন্তু disk করা হয় না। কারণ
    file এর উদ্দেশ্যই ভাগ করা: আপনি editor এ লিখবেন, compiler সেটা পড়বে,
    তারপর সেটা চালাবেন।
  </p>

  <p>
    আর এখানেই এই বইয়ের সবচেয়ে গুরুত্বপূর্ণ একটা ভুল ধারণা লুকিয়ে আছে।
  </p>

  <div class="box wrong">
    <div class="box-t">ভুল ধারণা</div>
    <p>
      <strong>"<code>write()</code> ১৩ ফেরত দিয়েছে, মানে ১৩ byte disk এ
      লেখা হয়ে গেছে।"</strong> সমগোত্রীয় ভুল:
      "<code>close()</code> করলে flush হয়ে যায়",
      "<code>fflush()</code> করেছি, তাই নিরাপদ"।
    </p>
    <p>
      <code>write()</code> ফেরত আসা মানে শুধু এটুকু: আপনার data
      kernel এর <strong>page cache</strong> এ পৌঁছেছে। সেটা RAM।
      এই মুহূর্তে power গেলে data নেই। Kernel সাধারণত লেখাটা কিছুক্ষণ
      আটকে রাখে — কয়েক সেকেন্ড পর্যন্ত — যাতে ছোট লেখাগুলো একসাথে বড়
      করে পাঠানো যায়, আর একই block বারবার লেখা হলে বাড়তি I/O বাঁচে।
    </p>
    <p>
      Disk এ সত্যিই পৌঁছেছে কিনা নিশ্চিত হতে <code>fsync(fd)</code>
      লাগে। আর তাতেও শেষ নয় — নতুন তৈরি করা file এর ক্ষেত্রে
      <em>parent directory</em> ও fsync করতে হয়, নইলে file এর নামটাই
      হারিয়ে যেতে পারে যদিও content লেখা হয়েছে। এই পুরো
      "durability contract" টা chapter 25 এর বিষয়, আর ওখানে
      <strong>fsyncgate</strong> ও দেখব — যেখানে Postgres আবিষ্কার করল
      <code>fsync()</code> fail করার পর Linux কীভাবে ভুলভাবে সফলতা
      রিপোর্ট করত, আর সেটা ঠিক করতে দুটো database কে নিজেদের
      recovery model বদলাতে হয়েছিল।
    </p>
  </div>

  <div class="box dev">
    <div class="box-t">আপনার কাজের সাথে যোগ</div>
    <p>
      এই কারণেই Postgres এ <code>synchronous_commit</code> নামে একটা
      setting আছে, আর সেটা <code>off</code> করলে TPS লাফিয়ে বাড়ে —
      আপনি durability বিক্রি করে throughput কিনছেন। একই কারণে Redis এ
      <code>appendfsync everysec</code> মানে "সবচেয়ে খারাপ ক্ষেত্রে এক
      সেকেন্ডের লেখা হারাবে", আর SQLite এর
      <code>PRAGMA synchronous=OFF</code> দিলে crash এ database
      corrupt হতে পারে। তিনটাই একই hardware সত্যের উপর দাঁড়িয়ে।
    </p>
  </div>

  <h2 id="c1-mech-policy">Mechanism আর policy — বইয়ের সবচেয়ে কাজের পার্থক্য</h2>

  <p>
    OS এর প্রতিটা অংশে এই দুটো আলাদা করে ভাবতে হয়:
  </p>

  <div class="tablewrap">
  <table>
    <thead>
      <tr><th>&nbsp;</th><th>Mechanism</th><th>Policy</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>প্রশ্ন</strong></td>
        <td>কীভাবে করা সম্ভব?</td>
        <td>কোনটা করা উচিত?</td>
      </tr>
      <tr>
        <td><strong>Scheduling</strong></td>
        <td>Context switch — register সরিয়ে রাখা, স্ট্যাক বদলানো</td>
        <td>কোন process পরে চলবে (EEVDF, MLFQ)</td>
      </tr>
      <tr>
        <td><strong>Memory</strong></td>
        <td>Page table, TLB, page fault handling</td>
        <td>RAM ভরে গেলে কোন page বের করা হবে</td>
      </tr>
      <tr>
        <td><strong>বদলায়?</strong></td>
        <td>কমই — hardware এর সাথে বাঁধা</td>
        <td>ঘন ঘন — tunable, version এ version বদলায়</td>
      </tr>
    </tbody>
  </table>
  </div>

  <p>
    কেন এই পার্থক্যটা কাজের? কারণ production এ কোনো সমস্যা হলে
    আপনি প্রায় সবসময় <em>policy</em> বদলান, mechanism নয়।
    <code>cpu.weight</code>, <code>vm.swappiness</code>,
    <code>dirty_ratio</code>, <code>GOMAXPROCS</code> — সবগুলোই policy
    knob। Mechanism বদলাতে হলে kernel patch লাগে।
  </p>

  <h2 id="c1-design">OS এর design goal — আর সেগুলোর দাম</h2>

  <ul>
    <li>
      <strong>Abstraction</strong> — যাতে আপনি transistor এর কথা না ভেবে
      program লিখতে পারেন।
    </li>
    <li>
      <strong>Performance</strong> — abstraction এর overhead যতটা সম্ভব কম,
      সময়ে (বাড়তি instruction) আর জায়গায় (kernel এর নিজের memory) দুদিকেই।
    </li>
    <li>
      <strong>Protection আর isolation</strong> — একটা process আরেকটাকে,
      বা kernel কে, নষ্ট করতে না পারে।
    </li>
    <li>
      <strong>Reliability</strong> — OS crash করলে তার উপরের সবকিছু যায়।
      Linux kernel এখন কয়েক কোটি লাইন code।
    </li>
    <li>
      <strong>Energy efficiency, security, mobility</strong> — battery,
      attacker আর ছোট device এর যুগে এগুলো আর গৌণ নয়।
    </li>
  </ul>

  <div class="box old">
    <div class="box-t">যেখানে source টা পুরনো</div>
    <p>
      OSTEP (২০১৫) protection এর প্রতিশ্রুতিটা নিঃশর্তভাবে দেয়:
      page table এর privilege bit থাকার কারণে user process kernel memory
      পড়তে পারে না। ২০১৮ এর <strong>Meltdown</strong> দেখিয়ে দিল
      কথাটা সত্য নয় — speculative execution ব্যবহার করে ওই bit কে
      পাশ কাটিয়ে kernel memory পড়া যায়, কারণ hardware অনুমান করে
      আগেই data টা cache এ তুলে ফেলে, আর privilege check টা হয় পরে।
    </p>
    <p>
      উত্তরে Linux এ এল <strong>KPTI (Kernel Page Table Isolation —
      প্রতিটা process এর address space থেকে kernel এর mapping সরিয়ে
      রাখা)</strong>, যার দাম হলো প্রতিটা syscall এ বাড়তি খরচ।
      অর্থাৎ "kernel কে প্রতিটা address space এ map করে রাখা" — যে
      design টা কয়েক দশক ধরে নিঃসন্দেহে সঠিক ধরা হতো — তা আংশিকভাবে
      ফিরিয়ে নিতে হয়েছে। Chapter 9 আর 10 এ এই খরচটা মাপব।
    </p>
  </div>

  <h2 id="c1-history">কীভাবে এই জায়গায় পৌঁছাল</h2>

  <p>
    OS সবসময় এমন ছিল না। ইতিহাসটা জানা দরকার কারণ প্রতিটা ধাপে
    <em>একটা নির্দিষ্ট সমস্যা</em> এই feature গুলো জন্ম দিয়েছে।
  </p>

  <pre class="ascii"><code>  ১৯৫০s   OS = শুধু একটা library
          ─────────────────────────────────────────
          একসাথে একটা program। মানুষ operator।
          সমস্যা: মেশিনের ভাড়া ঘণ্টায় লক্ষ ডলার,
                  আর CPU বসে থাকে I/O এর অপেক্ষায়।

  ১৯৬০s   Protection আর system call  (Atlas, ১৯৬১)
          ─────────────────────────────────────────
          File system library হতে পারে না — যেকোনো
          program যেকোনো file পড়ে ফেলবে। তাই
          trap instruction: privilege বাড়িয়ে
          kernel এ ঢোকা, কাজ শেষে ফেরত নামা।

  ১৯৭০s   Multiprogramming  (DEC PDP)
          ─────────────────────────────────────────
          একসাথে কয়েকটা job memory তে, I/O এর সময়
          অন্যটা চালাও। ফলাফল: memory protection
          বাধ্যতামূলক হলো, আর kernel এর ভিতরেই
          concurrency ঢুকে পড়ল (interrupt)।

  ১৯৭০s   UNIX  (Thompson, Ritchie — Bell Labs)
          ─────────────────────────────────────────
          ছোট ছোট program, pipe দিয়ে জোড়া:
             grep foo file.txt | wc -l
          C তে লেখা, ছোট আর পড়ার যোগ্য kernel।

  ১৯৮০s   PC — একধাপ পিছিয়ে যাওয়া
          ─────────────────────────────────────────
          DOS এ memory protection নেই। Mac OS 9 এ
          cooperative scheduling — একটা infinite
          loop পুরো মেশিন আটকে দেয়।

  ১৯৯০s+  আবার ফেরা: Linux, Mac OS X (UNIX core),
          Windows NT। আজ: Android, datacenter,
          container — সব এই বংশের।</code></pre>

  <p>
    সবচেয়ে গুরুত্বপূর্ণ ধাপটা ১৯৬০ এর — <strong>system call</strong> এর
    আবিষ্কার। প্রশ্নটা ছিল: file system কেন শুধু একটা library হতে পারে না?
    উত্তর: তাহলে যেকোনো program যেকোনো file পড়তে বা মুছতে পারবে, কারণ
    library আপনার program এর ভিতরেই চলে, আপনার সব permission নিয়ে।
    দরকার ছিল এমন একটা সীমানা যা পার হতে হলে privilege বদলায় — সেটাই
    trap, আর সেটাই chapter 4 এর বিষয়।
  </p>

  <div class="box note">
    <div class="box-t">এই বইয়ে যা নেই</div>
    <p>
      OSTEP এর মতোই আমরা networking এর ভিতরের অংশ (TCP/IP stack এর
      implementation), graphics device আর GPU, আর security এর গভীর
      আলোচনা বাদ রাখছি — প্রতিটা নিজেই একটা বই। তবে যেখানে এগুলো OS এর
      সাথে সরাসরি লাগে, সেখানে ছোঁব: socket আর epoll (chapter 19),
      Meltdown/KPTI (chapter 9), seccomp আর namespace (chapter 29)।
    </p>
  </div>

  <h2 id="c1-map">বাকি বইটা কীভাবে সাজানো</h2>

  <pre class="ascii"><code>  Part 1 — Virtualization          (ch 2–11)
     Process, fork/COW, trap আর context switch,
     scheduling (MLFQ → EEVDF → cgroup throttling),
     address space, page table, TLB, swap/OOM

  Part 2 — Concurrency             (ch 12–19)
     Thread, cache coherence, memory model,
     lock, condition variable, deadlock,
     event loop (epoll → io_uring → libuv/Go)

  Part 3 — Persistence             (ch 20–27)
     I/O device, flash/FTL, file আর inode,
     file system, page cache,
     durability contract, journaling, LSM-tree

  Part 4 — আজকের বাস্তবতা          (ch 28–30)
     Data integrity আর erasure coding,
     container (namespace + cgroup + overlayfs),
     runtime যেখানে OS এর সাথে ঘষা লাগে</code></pre>

  <p>
    ক্রমটা OSTEP এর, আর সেটা ইচ্ছাকৃত। Concurrency কে অনেক বই শুরুতে
    রাখে, কিন্তু context switch কখন হতে পারে আর address space কী — এটা
    না বুঝলে race condition কেন হয় তা ধরা যায় না। তাই process আর memory
    আগে, thread পরে।
  </p>

  <div class="qs">
    <h2 id="c1-q">প্রশ্ন</h2>
    <ol>
      <li>
        একটা ৮-core মেশিনে আপনি ৮টা <code>./cpu</code> process চালালেন আর
        output interleaved দেখলেন। এখন সেই একই ৮টা process কে
        <code>--cpus=1</code> দেওয়া একটা container এ চালালেন — output
        দেখতে একই রকম লাগবে, কিন্তু কোন মাপে দুটো পরিস্থিতি সম্পূর্ণ আলাদা?
        কোন tool দিয়ে পার্থক্যটা প্রমাণ করবেন?
      </li>
      <li>
        <code>mem.c</code> এর দুটো instance একই address ছাপছিল।
        ধরুন আপনি ASLR বন্ধ রাখলেন, কিন্তু program টা <code>fork()</code>
        দিয়ে একটা child বানাল আর দুজনেই <code>*p</code> বাড়াতে থাকল।
        Address একই থাকবে, কিন্তু counter গুলো কি একসাথে বাড়বে, নাকি আলাদা?
        উত্তরটা কোন mechanism এর উপর নির্ভর করে?
      </li>
      <li>
        <code>threads.c</code> এ <code>volatile</code> সরিয়ে
        <code>_Atomic int counter</code> লিখলে উত্তর সবসময় ঠিক আসবে।
        এখন যদি দুটো thread এর কাজ হতো "counter পড়ে, সেটা দেখে সিদ্ধান্ত
        নিয়ে, তারপর লেখা" — তাহলে <code>_Atomic</code> দিয়ে কি সমস্যা
        মিটত? কেন, বা কেন নয়?
      </li>
      <li>
        একটা program <code>write()</code> করে সফল return পেল, তারপর
        <code>close()</code> করল, তারপর process টা <code>exit()</code>
        করল — সব ঠিকঠাক। এর ঠিক পরেই মেশিনের power cable খুলে ফেলা হলো।
        Data টা থাকবে কি? আপনার উত্তর যদি "নির্ভর করে" হয়, তাহলে
        <em>কীসের</em> উপর নির্ভর করে — অন্তত তিনটা জিনিস বলুন।
      </li>
      <li>
        Mechanism আর policy এর পার্থক্য ব্যবহার করে বলুন: Linux এ
        scheduler টা CFS থেকে EEVDF এ বদলানো হলো — এটা mechanism এর
        পরিবর্তন না policy এর? আর এই উত্তরটা থেকে বুঝুন কেন kernel
        upgrade করলে আপনার latency profile বদলে যেতে পারে যদিও আপনি
        কোনো code বদলাননি।
      </li>
      <li>
        File system কে library বানানো যায় না — protection এর কারণে।
        কিন্তু আজকাল কিছু database (যেমন embedded SQLite, বা
        io_uring ব্যবহার করে userspace driver) kernel কে অনেকটা পাশ
        কাটিয়ে সরাসরি device এ কাজ করে। তাহলে ১৯৬০ এর সেই যুক্তিটা কি
        ভুল হয়ে গেল, নাকি এখানে protection অন্য কোনো জায়গা থেকে আসছে?
      </li>
    </ol>
  </div>

</section>

<section class="chapter" id="chapter-2" data-part="1" data-num="2"
         data-title="Process — OS এর প্রধান abstraction">

  <div class="ch-head">
    <div class="ch-eyebrow p1">
      Part 1 · Virtualization
      <span class="src">· OSTEP ch 4, pdf p46–57</span>
    </div>
    <h1>Process — OS এর প্রধান abstraction</h1>
    <p class="ch-lede">
      Disk এ পড়ে থাকা একটা file আর চলমান একটা program — দুটোর মধ্যে কী যোগ
      হলে প্রথমটা দ্বিতীয়টা হয়? উত্তরটা একটা kernel data structure, আর
      সেটা আপনি <code>/proc</code> দিয়ে নিজের চোখে দেখতে পারেন।
    </p>
  </div>

  <p>
    Process এর সংজ্ঞা সরল: <strong>একটা চলমান program</strong>।
    কিন্তু এই সরলতার নিচে একটা গুরুত্বপূর্ণ পার্থক্য আছে যেটা না ধরলে
    পরের কোনো chapter ঠিকভাবে বসবে না।
  </p>

  <p>
    আপনার disk এ <code>/usr/bin/node</code> একটা file। সেটা নিষ্প্রাণ —
    কিছু instruction আর static data, পড়ে আছে। এর মধ্যে "চলা" বলে কিছু নেই।
    আপনি <code>node</code> লিখলে OS ওই byte গুলো নিয়ে তার সাথে
    <em>আরও কিছু</em> যোগ করে একটা চলমান সত্তা বানায়। সেই যোগ করা
    জিনিসটাই process।
  </p>

  <div class="box note">
    <div class="box-t">Crux</div>
    <p>
      Physical CPU মাত্র কয়েকটা। তাহলে OS কীভাবে প্রায়-অসীম সংখ্যক
      CPU এর illusion দেয়? উত্তর: <strong>time sharing</strong> — একটা
      process চালাও, থামাও, আরেকটা চালাও, এত দ্রুত যে সবগুলো একসাথে
      চলছে মনে হয়। দাম হলো performance: প্রত্যেকে ধীরে চলে।
    </p>
  </div>

  <h2 id="c2-machine-state">Process = machine state</h2>

  <p>
    Process কী দিয়ে তৈরি, সেটা বোঝার সবচেয়ে কাজের উপায় হলো প্রশ্ন করা:
    <em>একটা চলমান program কী কী পড়তে বা বদলাতে পারে?</em> সেই তালিকাটাই
    তার machine state।
  </p>

  <div class="tablewrap">
  <table>
    <thead>
      <tr><th>উপাদান</th><th>কী থাকে</th><th>কোথায় দেখবেন</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Address space</strong></td>
        <td>code, static data, heap, stack — যে memory টা process ছুঁতে পারে</td>
        <td><code>/proc/&lt;pid&gt;/maps</code></td>
      </tr>
      <tr>
        <td><strong>Register</strong></td>
        <td>general purpose register, আর বিশেষ কয়েকটা (নিচে)</td>
        <td><code>/proc/&lt;pid&gt;/syscall</code>, gdb</td>
      </tr>
      <tr>
        <td><strong>PC / IP</strong></td>
        <td>Program Counter — এই মুহূর্তে কোন instruction চলছে</td>
        <td><code>/proc/&lt;pid&gt;/stat</code> (field 30)</td>
      </tr>
      <tr>
        <td><strong>SP / FP</strong></td>
        <td>Stack ও Frame Pointer — function এর parameter, local variable, return address</td>
        <td><code>/proc/&lt;pid&gt;/stat</code> (field 29)</td>
      </tr>
      <tr>
        <td><strong>I/O information</strong></td>
        <td>কোন কোন file খোলা আছে</td>
        <td><code>/proc/&lt;pid&gt;/fd/</code></td>
      </tr>
    </tbody>
  </table>
  </div>

  <p>
    শেষ সারিটা গুরুত্বপূর্ণ আর প্রায়ই ভুলে যাওয়া হয়: <strong>খোলা file
    গুলোও process এর state এর অংশ</strong>। এই কারণেই একটা process কে
    <code>kill</code> করলে তার সব file descriptor বন্ধ হয়ে যায়, আর
    এই কারণেই chapter 3 এ দেখব <code>fork()</code> করলে child ঠিক একই
    খোলা file গুলো পায় — একই file offset সহ।
  </p>

  <h2 id="c2-program-to-process">Program থেকে process — কী কী ঘটে</h2>

  <p>
    OS কে কয়েকটা কাজ করতে হয় program টা চালু করার আগে:
  </p>

  <pre class="ascii"><code>  DISK                          MEMORY (নতুন address space)
  ┌──────────────┐              ┌──────────────────────┐  উঁচু address
  │              │              │        stack         │  ↓ নিচের দিকে বাড়ে
  │ ELF file     │              │  argc, argv, env     │
  │ ┌──────────┐ │   load       ├──────────────────────┤
  │ │  code    │─┼───────────▶  │                      │
  │ ├──────────┤ │              │      (ফাঁকা)         │
  │ │ static   │─┼───────────▶  │                      │
  │ │ data     │ │              ├──────────────────────┤
  │ └──────────┘ │              │        heap          │  ↑ উপরের দিকে বাড়ে
  └──────────────┘              │   malloc() এখান থেকে │
                                ├──────────────────────┤
                    OS বানায়──▶ │    static data       │
                                ├──────────────────────┤
                                │       code           │  নিচু address
                                └──────────────────────┘</code></pre>
  <p class="figcap">
    Program loading: file এর byte + OS এর বানানো stack ও heap = process।
  </p>

  <ol>
    <li>
      <strong>Code আর static data load করা</strong> — executable format
      (Linux এ ELF) থেকে memory তে।
    </li>
    <li>
      <strong>Stack বানানো</strong> — C তে local variable, function
      parameter আর return address এর জন্য। OS এখানেই
      <code>main()</code> এর argument বসিয়ে দেয়: <code>argc</code> আর
      <code>argv</code>।
    </li>
    <li>
      <strong>Heap এর প্রস্তুতি</strong> — <code>malloc()</code> যেখান
      থেকে নেবে। শুরুতে ছোট, দরকারে বাড়ে।
    </li>
    <li>
      <strong>I/O এর প্রাথমিক ব্যবস্থা</strong> — UNIX এ প্রতিটা process
      তিনটা file descriptor নিয়ে শুরু করে: 0 = stdin, 1 = stdout,
      2 = stderr।
    </li>
    <li>
      <strong>Entry point এ লাফ দেওয়া</strong> — <code>main()</code> এ
      (আসলে তার আগে কিছু runtime setup), আর CPU টা process এর হাতে
      ছেড়ে দেওয়া।
    </li>
  </ol>

  <div class="box old">
    <div class="box-t">যেখানে source টা পুরনো</div>
    <p>
      OSTEP লেখে: OS কে "disk থেকে ওই byte গুলো পড়ে memory তে বসাতে হয়",
      আর যোগ করে যে পুরনো OS এটা <em>eagerly</em> করত, আধুনিক OS করে
      <em>lazily</em>। কথাটা সত্য কিন্তু এতটাই সংক্ষিপ্ত যে ভুল ছবি তৈরি হয় —
      আর বইয়ের পরের অংশের সাথে সাংঘর্ষিকও (paging chapter বলে loading
      lazy, আর এই chapter বলে OS byte পড়ে memory তে বসায়)।
    </p>
    <p>
      আসল পথটা হলো: <code>execve()</code> ELF এর
      <strong>PT_LOAD segment গুলো <code>mmap()</code> করে</strong> —
      অর্থাৎ page table এ mapping বসায়, কিন্তু কোনো byte পড়ে না।
      তারপর dynamic linker (<code>ld.so</code>) shared library গুলো map
      করে। Page গুলো আসে চাহিদামতো, <strong>page fault</strong> এর মাধ্যমে,
      যখন সত্যিই ওই address টা ছোঁয়া হয়।
    </p>
    <p>
      এর একটা মাপা ফল আছে যেটা আপনি রোজ দেখেন:
      <strong>একই binary দ্বিতীয়বার চালালে অনেক দ্রুত চালু হয়</strong> —
      কারণ page গুলো তখন page cache এ গরম, disk এ যেতে হয় না।
      Chapter 24 এ এটাই page cache। আর container এর
      <strong>cold start</strong> এর বড় অংশ এই একই কারণ: নতুন node এ
      image layer গুলো page-cache-cold, তাই প্রথম request ধীর —
      এই কারণেই image size আর layer এর ক্রম গুরুত্বপূর্ণ।
    </p>
  </div>

  <h2 id="c2-states">Process এর তিনটা অবস্থা</h2>

  <p>
    যেকোনো মুহূর্তে একটা process তিনটার একটায় থাকে:
  </p>

  <pre class="ascii"><code>                    scheduled
              ┌─────────────────────┐
              │                     ▼
        ┌──────────┐          ┌──────────┐
        │  READY   │          │ RUNNING  │
        │          │◀─────────│          │
        └──────────┘descheduled└──────────┘
              ▲                     │
              │                     │ I/O শুরু
              │ I/O শেষ             ▼
              │               ┌──────────┐
              └───────────────│ BLOCKED  │
                              └──────────┘

  RUNNING  — এই মুহূর্তে CPU তে instruction চালাচ্ছে
  READY    — চালানোর জন্য প্রস্তুত, কিন্তু OS এখন চালাচ্ছে না
  BLOCKED  — কোনো ঘটনার অপেক্ষায় (I/O, lock, timer);
             CPU দিলেও কাজে লাগবে না</code></pre>
  <p class="figcap">Process state machine। তীরগুলোর নাম মনে রাখা দরকার।</p>

  <p>
    <strong>READY আর BLOCKED এর পার্থক্যটাই এই diagram এর আসল কথা।</strong>
    READY process কে CPU দিলে সে কাজ করবে — সে শুধু অপেক্ষা করছে তার
    পালার জন্য। BLOCKED process কে CPU দিলে সে কিছুই করতে পারবে না,
    কারণ সে অপেক্ষা করছে <em>বাইরের কোনো ঘটনার</em>। তাই scheduler
    BLOCKED process কে বিবেচনাই করে না।
  </p>

  <p>
    দুটো process এর trace দেখলে পরিষ্কার হয়। প্রথমে দুটোই শুধু CPU ব্যবহার
    করছে, কোনো I/O নেই:
  </p>

  <pre class="ascii"><code>  সময়   Process 0    Process 1    টীকা
  ────   ──────────   ──────────   ─────────────────────
   1     Running      Ready
   2     Running      Ready
   3     Running      Ready
   4     Running      Ready        Process 0 শেষ
   5     —            Running
   6     —            Running
   7     —            Running
   8     —            Running      Process 1 শেষ</code></pre>

  <p>
    Process 1 চারটা সময়-একক পুরো বসে থাকল। এখন Process 0 যদি মাঝপথে
    I/O শুরু করে:
  </p>

  <pre class="ascii"><code>  সময়   Process 0    Process 1    টীকা
  ────   ──────────   ──────────   ──────────────────────────
   1     Running      Ready
   2     Running      Ready
   3     Running      Ready        Process 0 I/O শুরু করল
   4     Blocked      Running      P0 blocked, তাই P1 চলল
   5     Blocked      Running
   6     Blocked      Running
   7     Ready        Running      I/O শেষ → P0 এখন Ready
   8     Ready        Running      Process 1 শেষ
   9     Running      —
  10     Running      —            Process 0 শেষ</code></pre>

  <p>
    এখানে OS দুটো সিদ্ধান্ত নিয়েছে, আর দুটোই policy — mechanism নয়।
    প্রথমত, P0 blocked হওয়ার সাথে সাথে P1 চালিয়ে দিল, তাতে CPU খালি
    থাকল না। দ্বিতীয়ত, সময় ৭ এ I/O শেষ হওয়ার পরেও P0 তে ফেরত গেল না —
    P1 কে চলতে দিল। এটা ভালো সিদ্ধান্ত কি না, সেটা নির্ভর করে আপনি কী
    optimize করছেন, আর সেটাই chapter 5 আর 6 এর বিষয়।
  </p>

  <div class="box wrong">
    <div class="box-t">ভুল ধারণা</div>
    <p>
      <strong>"<code>top</code> এ load average ৮, মানে ৮টা process
      CPU খাচ্ছে।"</strong>
    </p>
    <p>
      Linux এ load average হলো <strong>RUNNING + READY</strong> process এর
      সংখ্যা (আর একটা বিশেষ ব্যতিক্রম — নিচে)। অর্থাৎ যারা চলছে
      <em>এবং</em> যারা চলার জন্য লাইনে দাঁড়িয়ে আছে। ৮ core এ load ৮
      মানে মোটামুটি পুরো ব্যবহার; ২ core এ load ৮ মানে প্রতিটা process
      তার সময়ের বড় অংশ লাইনে দাঁড়িয়ে কাটাচ্ছে।
    </p>
    <p>
      ব্যতিক্রমটা বিভ্রান্তিকর: Linux (অন্য UNIX এর তুলনায় ব্যতিক্রমীভাবে)
      load average এ <strong>uninterruptible sleep</strong> —
      <code>ps</code> এ state <code>D</code> — ও গোনে। অর্থাৎ যে process
      disk I/O এর জন্য আটকে আছে, সে CPU চাইছে না, তবু load বাড়াচ্ছে।
      তাই ধীর disk বা আটকে যাওয়া NFS mount এর কারণে load ২০ দেখা যেতে
      পারে যখন CPU প্রায় খালি। Load average দিয়ে CPU saturation মাপা
      তাই ভুল — <code>%util</code> বা PSI (chapter 11) দেখা উচিত।
    </p>
    <pre><code># state কলাম দেখুন: R=running/ready, S=sleep, D=uninterruptible
$ ps -eo pid,stat,wchan:20,comm | head
# R  → RUNNING বা READY
# S  → BLOCKED (interruptible — signal এ জাগবে)
# D  → BLOCKED (uninterruptible — সাধারণত disk I/O)
# Z  → ZOMBIE (নিচে দেখুন)</code></pre>
  </div>

  <h2 id="c2-pcb">PCB — যে structure টা process কে বাস্তব করে</h2>

  <p>
    OS নিজেও একটা program, আর যেকোনো program এর মতোই তার data structure
    আছে। প্রতিটা process সম্পর্কে যা জানা দরকার, তা একটা structure এ
    রাখা হয়। এর নাম <strong>PCB (Process Control Block — প্রতিটা process
    এর metadata রাখার kernel data structure)</strong>; Linux এ এর নাম
    <code>struct task_struct</code>।
  </p>

  <p>
    xv6 (একটা শিক্ষামূলক UNIX) এর structure টা ছোট বলে পড়া সহজ:
  </p>

  <div class="codewrap"><span class="lang">c</span>
  <pre><code>/* xv6: the registers saved and restored to stop and
   restart a process — this IS the context switch */
struct context {
    int eip;     /* instruction pointer — কোথায় ছিল */
    int esp;     /* stack pointer */
    int ebx; int ecx; int edx;
    int esi; int edi; int ebp;
};

enum proc_state { UNUSED, EMBRYO, SLEEPING,
                  RUNNABLE, RUNNING, ZOMBIE };

/* xv6: everything the kernel knows about one process */
struct proc {
    char *mem;                  /* start of process memory */
    uint sz;                    /* size of process memory */
    char *kstack;               /* bottom of kernel stack for this proc */
    enum proc_state state;      /* the state machine above */
    int pid;                    /* process ID */
    struct proc *parent;        /* who created it — needed for wait() */
    void *chan;                 /* if non-zero, sleeping on this channel */
    int killed;
    struct file *ofile[NOFILE]; /* open files — part of process state */
    struct inode *cwd;          /* current directory */
    struct context context;     /* switch here to run this process */
    struct trapframe *tf;       /* trap frame for current interrupt */
};</code></pre></div>

  <p>
    কয়েকটা field আলাদা করে দেখার মতো:
  </p>

  <ul>
    <li>
      <code>context</code> — process থামলে তার register গুলো এখানে জমা
      হয়। আবার চালাতে হলে এখান থেকে ফিরিয়ে দিলেই সে ঠিক যেখানে ছিল
      সেখান থেকে চলতে শুরু করে। <strong>এটাই context switch</strong>,
      chapter 4 এ পুরোটা।
    </li>
    <li>
      <code>parent</code> — কে এই process বানিয়েছে। <code>wait()</code>
      কাজ করার জন্য এটা দরকার, আর zombie আর orphan বোঝার জন্যও।
    </li>
    <li>
      <code>ofile[]</code> — খোলা file। আবারও: I/O state process এর অংশ।
    </li>
    <li>
      <code>chan</code> — BLOCKED হলে <em>কীসের</em> অপেক্ষায়। Linux এ
      এটাই <code>/proc/&lt;pid&gt;/wchan</code> — আটকে যাওয়া process
      debug করার সময় এটা প্রথম দেখার জিনিস।
    </li>
  </ul>

  <p>
    লক্ষ করুন <code>enum</code> টায় তিনটার বেশি state আছে।
    আমাদের diagram এ ছিল RUNNING/READY/BLOCKED (xv6 এ
    RUNNING/RUNNABLE/SLEEPING), কিন্তু বাস্তবে শুরুর একটা state লাগে
    (<code>EMBRYO</code>) আর শেষেরও একটা — <code>ZOMBIE</code>।
  </p>

  <h2 id="c2-zombie">Zombie — মরেও যায়নি</h2>

  <p>
    একটা process <code>exit()</code> করল। তার memory ছেড়ে দেওয়া যায়,
    file বন্ধ করা যায়। কিন্তু একটা জিনিস এখনো দরকার:
    <strong>তার exit code</strong>। Parent জানতে চায় কাজটা সফল হয়েছিল
    কি না (UNIX এ 0 মানে সফল, non-zero মানে না)।
  </p>

  <p>
    তাই process টা মরার পরেও PCB টা রেখে দেওয়া হয়, শুধু exit status টুকু
    নিয়ে। এই অবস্থার নাম <strong>zombie</strong>। Parent
    <code>wait()</code> করলে status টা পায়, আর তখন kernel শেষ
    structure টাও মুছে ফেলে।
  </p>

  <pre class="ascii"><code>  child: exit(0)
       │
       ▼
  ┌──────────┐   parent wait() করেনি
  │  ZOMBIE  │───────────────────────▶ PCB রয়ে গেল
  └──────────┘   (process table এ জায়গা দখল)
       │
       │ parent wait() করল → status পড়ল
       ▼
    সম্পূর্ণ মুছে গেল</code></pre>

  <div class="box wrong">
    <div class="box-t">ভুল ধারণা</div>
    <p>
      <strong>"Zombie process CPU বা memory খাচ্ছে, তাই server ধীর।"</strong>
    </p>
    <p>
      Zombie এর কোনো memory নেই, কোনো code চলছে না, CPU এর হিসাবে সে
      শূন্য। সে শুধু process table এর একটা entry আর একটা PID দখল করে
      আছে। একটা-দুটো zombie সম্পূর্ণ নিরীহ।
    </p>
    <p>
      আসল বিপদ হলো <em>জমতে থাকা</em> zombie: PID এর একটা সীমা আছে
      (<code>/proc/sys/kernel/pid_max</code>), আর হাজারে হাজারে zombie
      জমলে নতুন process তৈরি করা যায় না — <code>fork()</code> ব্যর্থ হয়
      <code>EAGAIN</code> দিয়ে। এটা সবসময় parent এর bug: সে
      <code>wait()</code> করছে না।
    </p>
    <p>
      <strong>Container এ এটা খুব সাধারণ।</strong> আপনি যদি Dockerfile এ
      সরাসরি <code>CMD ["node", "server.js"]</code> দেন, তাহলে node হয়ে
      যায় PID 1। কিন্তু PID 1 এর একটা বিশেষ দায়িত্ব আছে — যেসব process
      এর parent মরে গেছে (orphan), তারা PID 1 এর সন্তান হয়, আর PID 1 কেই
      তাদের <code>wait()</code> করতে হয়। Node সেটা করে না, তাই zombie
      জমে। সমাধান: <code>docker run --init</code>, বা
      <code>tini</code>/<code>dumb-init</code> কে PID 1 বানানো।
      Chapter 29 এ PID namespace এর সাথে এটা ফিরে আসবে।
    </p>
    <pre><code># zombie খুঁজুন
$ ps -eo pid,ppid,stat,comm | awk '$3 ~ /^Z/'
# PPID কলামটাই দোষী parent</code></pre>
  </div>

  <h2 id="c2-proc">হাতে-কলমে — <code>/proc</code> দিয়ে abstraction দেখা</h2>

  <p>
    এই chapter এর সবকিছু কাল্পনিক শোনাতে পারে। শোনার দরকার নেই —
    Linux এ প্রতিটা process এর PCB এর বড় অংশ file হিসেবে পড়া যায়।
    একটা process চালিয়ে দেখুন:
  </p>

  <pre><code>$ sleep 300 &amp;
[1] 48231

$ ls /proc/48231/
cmdline   environ  fd/      maps     stat     status   wchan
cwd       exe      limits   mem      statm    syscall  task/</code></pre>

  <p><strong>Address space টা দেখুন</strong> — উপরের diagram টা এখানে বাস্তব:</p>

  <pre><code>$ cat /proc/48231/maps
55d8c4e00000-55d8c4e02000 r--p ...  /usr/bin/sleep     ← code (read-only)
55d8c4e02000-55d8c4e06000 r-xp ...  /usr/bin/sleep     ← code (executable)
55d8c4e06000-55d8c4e08000 r--p ...  /usr/bin/sleep     ← static data
55d8c4e09000-55d8c4e0a000 rw-p ...  /usr/bin/sleep     ← writable data
55d8c5f0a000-55d8c5f2b000 rw-p ...  [heap]             ← heap
7f2a1c000000-7f2a1c028000 r--p ...  /lib/libc.so.6     ← shared library
7ffd4a5c0000-7ffd4a5e1000 rw-p ...  [stack]            ← stack
7ffd4a5f4000-7ffd4a5f8000 r--p ...  [vvar]
7ffd4a5f8000-7ffd4a5fa000 r-xp ...  [vdso]             ← chapter 1 এর vDSO!</code></pre>

  <p>
    শেষ লাইনটা লক্ষ করুন — chapter 1 এ বলেছিলাম
    <code>clock_gettime()</code> syscall ছাড়াই ফেরে কারণ kernel একটা page
    map করে রাখে। ওই <code>[vdso]</code> টাই সেটা, প্রতিটা process এর
    address space এ।
  </p>

  <p><strong>State আর wait channel:</strong></p>

  <pre><code>$ grep -E '^(State|Threads|VmRSS|VmSize)' /proc/48231/status
State:   S (sleeping)          ← BLOCKED
Threads: 1
VmSize:  2776 kB               ← virtual — বুক করা address space
VmRSS:   1024 kB               ← resident — সত্যিই RAM এ আছে

$ cat /proc/48231/wchan
hrtimer_nanosleep              ← ঠিক কীসের অপেক্ষায় আটকে আছে</code></pre>

  <p>
    <code>VmSize</code> আর <code>VmRSS</code> এর পার্থক্যটা মনে রাখুন —
    chapter 11 এ এটাই সবচেয়ে বেশি ভুল বোঝা মাপ। এখানে ২৭৭৬kB address
    space বুক করা, কিন্তু মাত্র ১০২৪kB সত্যিই RAM এ। বাকিটা lazy loading
    এর কারণে এখনো আসেইনি।
  </p>

  <p><strong>খোলা file গুলো:</strong></p>

  <pre><code>$ ls -l /proc/48231/fd/
lrwx------ 0 -&gt; /dev/pts/3      ← stdin
lrwx------ 1 -&gt; /dev/pts/3      ← stdout
lrwx------ 2 -&gt; /dev/pts/3      ← stderr</code></pre>

  <p>
    তিনটাই terminal এ যাচ্ছে। এটাই <code>struct proc</code> এর
    <code>ofile[]</code>, শুধু file হিসেবে দেখানো।
  </p>

  <div class="box dev">
    <div class="box-t">আপনার কাজের সাথে যোগ</div>
    <p>
      এই <code>/proc</code> টাই যেখান থেকে আপনার সব tool তথ্য নেয় —
      <code>ps</code>, <code>top</code>, <code>htop</code> সবাই
      <code>/proc</code> পড়ে। কোনো গোপন API নেই।
    </p>
    <p>
      আর এই কারণেই container এ একটা বিখ্যাত সমস্যা হয়:
      Container এর ভিতরে <code>/proc/cpuinfo</code> আর
      <code>/proc/meminfo</code> সাধারণত <strong>host এর</strong> মান
      দেখায়, cgroup limit এর নয়। তাই JVM বা Go runtime যখন
      "কত core আছে?" জিজ্ঞেস করে, সে ৬৪ দেখে — যদিও আপনি ২ core এর
      quota দিয়েছেন। ফলাফল: ৬৪টা thread এর pool, অকারণ context switch,
      আর throttling। Chapter 7 আর 30 এ এটাই মূল আলোচনা।
    </p>
    <pre><code># container এর ভিতরে আসল limit কোথায়
$ cat /sys/fs/cgroup/cpu.max        # "200000 100000" = 2 core
$ cat /sys/fs/cgroup/memory.max     # byte এ
# অথচ:
$ nproc                             # host এর core সংখ্যা দেখাতে পারে</code></pre>
  </div>

  <h2 id="c2-api">Process API — যা প্রতিটা OS এ থাকতে হয়</h2>

  <p>
    বিস্তারিত API পরের chapter এ, কিন্তু যেকোনো OS এ এই কাজগুলোর ব্যবস্থা
    থাকতেই হয়:
  </p>

  <div class="tablewrap">
  <table>
    <thead>
      <tr><th>কাজ</th><th>কী করে</th><th>POSIX</th></tr>
    </thead>
    <tbody>
      <tr><td><strong>Create</strong></td><td>নতুন process বানানো</td><td><code>fork()</code>, <code>execve()</code>, <code>posix_spawn()</code></td></tr>
      <tr><td><strong>Destroy</strong></td><td>জোর করে থামানো</td><td><code>kill()</code> + signal</td></tr>
      <tr><td><strong>Wait</strong></td><td>শেষ হওয়া পর্যন্ত অপেক্ষা</td><td><code>wait()</code>, <code>waitpid()</code></td></tr>
      <tr><td><strong>Control</strong></td><td>থামানো/চালু করা</td><td><code>SIGSTOP</code>, <code>SIGCONT</code></td></tr>
      <tr><td><strong>Status</strong></td><td>তথ্য নেওয়া</td><td><code>/proc</code>, <code>getrusage()</code></td></tr>
    </tbody>
  </table>
  </div>

  <p>
    আপনি যখন terminal এ <kbd>Ctrl</kbd>+<kbd>Z</kbd> চাপেন, shell
    process টাকে <code>SIGSTOP</code> পাঠায় — সে RUNNING/READY থেকে
    একটা থেমে-থাকা অবস্থায় যায়। <code>fg</code> লিখলে
    <code>SIGCONT</code> যায়, আর সে আবার READY হয়। State machine টা
    আপনি প্রতিদিন হাতে চালান।
  </p>

  <h2 id="c2-time-space">Time sharing আর space sharing</h2>

  <p>
    Resource ভাগ করার দুটো মৌলিক উপায়, আর দুটোই এই বইয়ে বারবার আসবে:
  </p>

  <ul>
    <li>
      <strong>Time sharing</strong> — একজন কিছুক্ষণ ব্যবহার করে, তারপর
      আরেকজন। CPU এভাবেই ভাগ হয়। Network link ও।
    </li>
    <li>
      <strong>Space sharing</strong> — resource টা ভাগ করে দেওয়া হয়।
      Disk এভাবে ভাগ হয়: একটা block একটা file কে দিলে, সেটা মুছে না
      ফেলা পর্যন্ত অন্য file পাবে না। Memory ও মূলত space-shared।
    </li>
  </ul>

  <p>
    এই পার্থক্যটা কেন কাজের? কারণ দুটোর failure mode আলাদা।
    Time-shared resource শেষ হলে সবাই <em>ধীর</em> হয় (CPU contention)।
    Space-shared resource শেষ হলে কাজ <em>ব্যর্থ</em> হয় —
    <code>ENOSPC</code>, বা OOM kill। তাই capacity planning এ
    দুটোকে আলাদা করে ভাবতে হয়।
  </p>

  <div class="qs">
    <h2 id="c2-q">প্রশ্ন</h2>
    <ol>
      <li>
        একটা process <code>/proc/&lt;pid&gt;/maps</code> এ দেখাচ্ছে
        <code>VmSize: 4 GB</code> কিন্তু <code>VmRSS: 80 MB</code>।
        আরেকটা দেখাচ্ছে <code>VmSize: 200 MB</code>,
        <code>VmRSS: 190 MB</code>। কোনটা OOM kill হওয়ার ঝুঁকিতে বেশি,
        আর কেন? আপনার উত্তরে "বুক করা" আর "সত্যিই পাওয়া" এর পার্থক্যটা
        ব্যবহার করুন।
      </li>
      <li>
        State machine এ BLOCKED থেকে সরাসরি RUNNING এ কোনো তীর নেই —
        I/O শেষ হলে process আগে READY তে যায়। এই বাড়তি ধাপটা কেন?
        সরাসরি RUNNING করে দিলে কী সমস্যা হতো?
      </li>
      <li>
        আপনার container এ node হলো PID 1, আর সে একটা shell script
        spawn করে যেটা নিজে আরও child বানিয়ে মরে যায়। কয়েক দিন পর
        <code>fork()</code> ব্যর্থ হতে শুরু করল <code>EAGAIN</code> দিয়ে।
        কী ঘটেছে, আর <code>--init</code> ঠিক কোন কাজটা করে যেটা node
        করছিল না?
      </li>
      <li>
        <code>ps</code> এ একটা process <code>D</code> state এ আটকে আছে,
        আর <code>kill -9</code> দিয়েও মরছে না। কেন <code>SIGKILL</code>
        কাজ করছে না? <code>/proc/&lt;pid&gt;/wchan</code> পড়ে আপনি কী
        তথ্য পাবেন যা সিদ্ধান্ত নিতে সাহায্য করবে?
      </li>
      <li>
        Chapter 1 এ দেখেছেন OS "মিথ্যা বলে"। এই chapter এর
        <code>/proc</code> অংশ দেখে বলুন: container এর ভিতরে
        <code>/proc/cpuinfo</code> host এর core দেখানো — এটা কি
        abstraction নাকি leak? আপনার runtime কোন প্রশ্নটা জিজ্ঞেস করলে
        সঠিক উত্তর পেত?
      </li>
      <li>
        Time sharing আর space sharing এর পার্থক্য ব্যবহার করে বলুন:
        Kubernetes এ CPU limit ছাড়িয়ে গেলে pod throttled হয়, কিন্তু
        memory limit ছাড়ালে pod <em>মারা যায়</em>। এই অসমতা কেন —
        এটা Kubernetes এর নকশার খামখেয়াল, নাকি resource দুটোর
        প্রকৃতিগত পার্থক্য?
      </li>
    </ol>
  </div>

</section>

  <!-- @@CHAPTERS@@ -->
    </div>
  </main>
</div>

<div id="searchOverlay">
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="খোঁজো">
    <div class="search-head">
      <span aria-hidden="true">🔍</span>
      <input id="searchInput" type="text" placeholder="Concept, chapter বা technical term…" autocomplete="off" spellcheck="false" />
    </div>
    <div id="searchResults"></div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> চলাচল</span>
      <span><kbd>↵</kbd> খোলো</span>
      <span><kbd>Esc</kbd> বন্ধ</span>
    </div>
  </div>
</div>

<script>
/* ============================================================
   App: hash router (#/chapter-N), TOC, client-side search,
   theme toggle. No dependencies. Chapters are <section
   class="chapter" id="chapter-N" data-part="1|2|3"
   data-title="..."> blocks appended into #page.
   ============================================================ */
(function () {
  "use strict";

  var STORE = "tsp.v1";
  var PART_NAMES = {
    "1": "Virtualization",
    "2": "Concurrency",
    "3": "Persistence",
    "0": "শুরুর আগে"
  };

  /* ---------- storage (may throw in private mode) ---------- */
  function load() {
    try { return JSON.parse(localStorage.getItem(STORE)) || {}; }
    catch (e) { return {}; }
  }
  function save(patch) {
    try {
      var s = load();
      for (var k in patch) s[k] = patch[k];
      localStorage.setItem(STORE, JSON.stringify(s));
    } catch (e) { /* ignore */ }
  }

  /* ---------- theme ---------- */
  function applyTheme(t) {
    if (t === "light" || t === "dark") {
      document.documentElement.setAttribute("data-theme", t);
    } else {
      document.documentElement.removeAttribute("data-theme");
    }
  }
  function currentTheme() {
    var t = document.documentElement.getAttribute("data-theme");
    if (t) return t;
    return window.matchMedia &&
      window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  }
  applyTheme(load().theme);
  document.getElementById("themeBtn").addEventListener("click", function () {
    var next = currentTheme() === "dark" ? "light" : "dark";
    applyTheme(next); save({ theme: next });
  });

  /* ---------- chapter registry ---------- */
  function chapters() {
    return Array.prototype.slice.call(
      document.querySelectorAll("#page > section.chapter")
    );
  }

  /* ---------- sidebar TOC ---------- */
  function buildTOC() {
    var nav = document.getElementById("sidebar");
    var list = chapters();
    nav.textContent = "";
    var lastPart = null;

    list.forEach(function (sec) {
      var part = sec.getAttribute("data-part") || "0";
      if (part !== lastPart) {
        var h = document.createElement("div");
        h.className = "toc-part p" + part;
        h.textContent = PART_NAMES[part] || part;
        nav.appendChild(h);
        lastPart = part;
      }
      var a = document.createElement("a");
      a.className = "toc-item p" + part;
      a.href = "#/" + sec.id;
      a.setAttribute("data-for", sec.id);

      var n = document.createElement("span");
      n.className = "num";
      n.textContent = sec.getAttribute("data-num") || "";
      var t = document.createElement("span");
      t.textContent = sec.getAttribute("data-title") || sec.id;

      a.appendChild(n); a.appendChild(t);
      nav.appendChild(a);
    });
  }

  function markActive(id) {
    var items = document.querySelectorAll("a.toc-item");
    for (var i = 0; i < items.length; i++) {
      var on = items[i].getAttribute("data-for") === id;
      items[i].classList.toggle("active", on);
      if (on && items[i].scrollIntoView) {
        var r = items[i].getBoundingClientRect();
        if (r.top < 60 || r.bottom > window.innerHeight) {
          items[i].scrollIntoView({ block: "center" });
        }
      }
    }
  }

  /* ---------- router ---------- */
  function parseHash() {
    var h = location.hash || "";
    var m = h.match(/^#\/(.+?)(?:@(.+))?$/);
    if (m) return { id: m[1], anchor: m[2] || null };
    // tolerate bare "#chapter-3"
    var m2 = h.match(/^#(chapter-[\w-]+|cover)$/);
    if (m2) return { id: m2[1], anchor: null };
    return { id: null, anchor: null };
  }

  function show(id, anchor, push) {
    var list = chapters();
    if (!list.length) return;
    var target = null;
    for (var i = 0; i < list.length; i++) if (list[i].id === id) target = list[i];
    if (!target) target = list[0];

    list.forEach(function (s) { s.classList.toggle("on", s === target); });
    markActive(target.id);
    buildChapNav(target, list);

    document.title = (target.getAttribute("data-title")
      ? target.getAttribute("data-title") + " — তিনটি সহজ পাঠ"
      : "তিনটি সহজ পাঠ");

    if (push && location.hash !== "#/" + target.id) {
      history.replaceState(null, "", "#/" + target.id);
    }
    save({ last: target.id });

    if (anchor) {
      var el = document.getElementById(anchor);
      if (el) { el.scrollIntoView(); return; }
    }
    window.scrollTo(0, 0);
    closeSidebar();
  }

  function buildChapNav(cur, list) {
    var old = cur.querySelector(".chnav");
    if (old) old.remove();
    var i = list.indexOf(cur);
    var prev = list[i - 1], next = list[i + 1];
    if (!prev && !next) return;

    var wrap = document.createElement("div");
    wrap.className = "chnav";
    function mk(sec, dir, cls) {
      var a = document.createElement("a");
      a.href = "#/" + sec.id; a.className = cls;
      var d = document.createElement("span"); d.className = "dir"; d.textContent = dir;
      var t = document.createElement("span"); t.className = "t";
      t.textContent = sec.getAttribute("data-title") || sec.id;
      a.appendChild(d); a.appendChild(t);
      return a;
    }
    if (prev) wrap.appendChild(mk(prev, "← আগের", "prev"));
    if (next) wrap.appendChild(mk(next, "পরের →", "next"));
    cur.appendChild(wrap);
  }

  window.addEventListener("hashchange", function () {
    var p = parseHash();
    show(p.id, p.anchor, false);
  });

  /* ---------- sidebar drawer ---------- */
  function openSidebar() {
    document.getElementById("sidebar").classList.add("open");
    document.getElementById("scrim").classList.add("on");
    document.getElementById("menuBtn").setAttribute("aria-expanded", "true");
  }
  function closeSidebar() {
    document.getElementById("sidebar").classList.remove("open");
    document.getElementById("scrim").classList.remove("on");
    document.getElementById("menuBtn").setAttribute("aria-expanded", "false");
  }
  document.getElementById("menuBtn").addEventListener("click", function () {
    var open = document.getElementById("sidebar").classList.contains("open");
    if (open) closeSidebar(); else openSidebar();
  });
  document.getElementById("scrim").addEventListener("click", closeSidebar);

  /* ---------- reading progress ---------- */
  window.addEventListener("scroll", function () {
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    var pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
    document.getElementById("progress").style.width = pct + "%";
  }, { passive: true });

  /* ---------- search ---------- */
  var INDEX = null;
  function buildIndex() {
    INDEX = [];
    chapters().forEach(function (sec) {
      var title = sec.getAttribute("data-title") || sec.id;
      var blocks = sec.querySelectorAll("h2, h3, p, li, .box, pre");
      for (var i = 0; i < blocks.length; i++) {
        var txt = (blocks[i].textContent || "").replace(/\s+/g, " ").trim();
        if (txt.length < 18) continue;
        var head = blocks[i].tagName === "H2" || blocks[i].tagName === "H3";
        INDEX.push({
          id: sec.id, chapter: title,
          anchor: blocks[i].id || null,
          text: txt, weight: head ? 3 : 1
        });
      }
      INDEX.push({ id: sec.id, chapter: title, anchor: null, text: title, weight: 5 });
    });
  }

  function search(q) {
    if (!INDEX) buildIndex();
    q = q.trim().toLowerCase();
    if (q.length < 2) return [];
    var terms = q.split(/\s+/);
    var hits = [];
    for (var i = 0; i < INDEX.length; i++) {
      var low = INDEX[i].text.toLowerCase();
      var score = 0, all = true;
      for (var t = 0; t < terms.length; t++) {
        var at = low.indexOf(terms[t]);
        if (at === -1) { all = false; break; }
        score += INDEX[i].weight + (at === 0 ? 2 : 0);
      }
      if (all) hits.push({ rec: INDEX[i], score: score, at: low.indexOf(terms[0]) });
    }
    hits.sort(function (a, b) { return b.score - a.score; });
    // one hit per chapter+text, cap the list
    var seen = {}, out = [];
    for (var j = 0; j < hits.length && out.length < 40; j++) {
      var k = hits[j].rec.id + "|" + hits[j].rec.text.slice(0, 40);
      if (seen[k]) continue;
      seen[k] = 1; out.push(hits[j]);
    }
    return out;
  }

  function snippet(text, at, term) {
    var start = Math.max(0, at - 55);
    var s = (start > 0 ? "…" : "") + text.slice(start, at + 130) + "…";
    // highlight without innerHTML injection
    var frag = document.createDocumentFragment();
    var low = s.toLowerCase(), pos = 0, tl = term.length;
    while (true) {
      var i = low.indexOf(term, pos);
      if (i === -1) { frag.appendChild(document.createTextNode(s.slice(pos))); break; }
      frag.appendChild(document.createTextNode(s.slice(pos, i)));
      var m = document.createElement("mark");
      m.textContent = s.slice(i, i + tl);
      frag.appendChild(m);
      pos = i + tl;
    }
    return frag;
  }

  var selIdx = -1;
  function renderResults(q) {
    var box = document.getElementById("searchResults");
    box.textContent = ""; selIdx = -1;
    var res = search(q);
    if (!q.trim()) {
      var d0 = document.createElement("div");
      d0.className = "search-empty";
      d0.textContent = "Chapter এর নাম বা যেকোনো technical term লেখো।";
      box.appendChild(d0); return;
    }
    if (!res.length) {
      var d = document.createElement("div");
      d.className = "search-empty";
      d.textContent = "কিছু পাওয়া যায়নি।";
      box.appendChild(d); return;
    }
    var term = q.trim().toLowerCase().split(/\s+/)[0];
    res.forEach(function (h) {
      var a = document.createElement("a");
      a.className = "sr";
      a.href = "#/" + h.rec.id + (h.rec.anchor ? "@" + h.rec.anchor : "");
      var t = document.createElement("span");
      t.className = "sr-t"; t.textContent = h.rec.chapter;
      var c = document.createElement("span");
      c.className = "sr-c";
      c.appendChild(snippet(h.rec.text, Math.max(0, h.at), term));
      a.appendChild(t); a.appendChild(c);
      a.addEventListener("click", closeSearch);
      box.appendChild(a);
    });
  }

  function openSearch() {
    document.getElementById("searchOverlay").classList.add("on");
    var inp = document.getElementById("searchInput");
    inp.value = ""; renderResults(""); inp.focus();
  }
  function closeSearch() {
    document.getElementById("searchOverlay").classList.remove("on");
  }
  document.getElementById("searchBtn").addEventListener("click", openSearch);
  document.getElementById("searchOverlay").addEventListener("click", function (e) {
    if (e.target.id === "searchOverlay") closeSearch();
  });
  document.getElementById("searchInput").addEventListener("input", function (e) {
    renderResults(e.target.value);
  });
  document.getElementById("searchInput").addEventListener("keydown", function (e) {
    var items = document.querySelectorAll("a.sr");
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      if (!items.length) return;
      if (selIdx >= 0) items[selIdx].classList.remove("sel");
      selIdx += (e.key === "ArrowDown" ? 1 : -1);
      if (selIdx < 0) selIdx = items.length - 1;
      if (selIdx >= items.length) selIdx = 0;
      items[selIdx].classList.add("sel");
      items[selIdx].scrollIntoView({ block: "nearest" });
    } else if (e.key === "Enter") {
      if (selIdx >= 0 && items[selIdx]) items[selIdx].click();
      else if (items.length) items[0].click();
    }
  });

  /* ---------- keyboard ---------- */
  document.addEventListener("keydown", function (e) {
    var overlay = document.getElementById("searchOverlay").classList.contains("on");
    if (e.key === "Escape") { if (overlay) closeSearch(); else closeSidebar(); return; }
    var typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target.tagName || ""));
    if (typing || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === "/") { e.preventDefault(); openSearch(); return; }
    if (e.key === "t" || e.key === "T") { document.getElementById("themeBtn").click(); return; }
    var list = chapters();
    var cur = null;
    for (var i = 0; i < list.length; i++) if (list[i].classList.contains("on")) cur = list[i];
    var i2 = list.indexOf(cur);
    if ((e.key === "j" || e.key === "ArrowRight") && list[i2 + 1]) location.hash = "#/" + list[i2 + 1].id;
    if ((e.key === "k" || e.key === "ArrowLeft") && list[i2 - 1]) location.hash = "#/" + list[i2 - 1].id;
  });

  /* ---------- boot ---------- */
  function boot() {
    buildTOC();
    var p = parseHash();
    var id = p.id || load().last || null;
    show(id, p.anchor, true);
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else { boot(); }
})();
</script>
</body>
</html>
